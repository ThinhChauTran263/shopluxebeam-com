{% comment %}
  Header section - Optimized version (CSS and JS extracted)
{% endcomment %}

<!-- Announcement Bar -->
<div class="announcement-bar-luxe">
  <div class="container">
    <div class="announcement-content-luxe">
      {% if section.settings.announcement_text != blank %}
        {{ section.settings.announcement_text }}
      {% else %}
        ❤️ Spring Sale Now Live! ❤️
      {% endif %}
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="main-header-luxe">
  <div class="header-wrapper-luxe">
    <!-- Logo -->
    <div class="header-logo-luxe">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 150 }}" alt="{{ shop.name }}" class="logo-img" width="150" height="auto">
        {% else %}
          <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 0L25.6942 16.3058L42 21L25.6942 25.6942L21 42L16.3058 25.6942L0 21L16.3058 16.3058L21 0Z" fill="#D4A574"/>
          </svg>
        {% endif %}
      </a>
    </div>

    <!-- Main Navigation -->
    <nav class="main-navigation-luxe">
      <ul class="nav-menu-luxe">
        <li><a href="{{ routes.root_url }}">HOME</a></li>
        <li class="has-dropdown-luxe">
          <a href="{{ collections.all.url }}">LAMPS <span class="dropdown-arrow-luxe">▾</span></a>
          <ul class="dropdown-menu-luxe">
            {% for collection in collections limit: 5 %}
              {% unless collection.handle == 'frontpage' %}
                <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
              {% endunless %}
            {% endfor %}
          </ul>
        </li>
        <li><a href="{{ collections['led-lights'].url | default: collections.all.url }}">LED LIGHTS</a></li>
        <li><a href="{{ collections['galaxy-lights'].url | default: collections.all.url }}">GALAXY LIGHTS</a></li>
        <li><a href="{{ pages.contact.url | default: '/pages/contact' }}">CONTACT</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions-luxe">
      <!-- Search -->
      <button class="search-toggle-luxe" type="button" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="cart-link-luxe">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count-luxe">({{ cart.item_count }})</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="mobile-toggle-luxe" type="button" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu-luxe">
    <ul class="mobile-nav-luxe">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ collections.all.url }}">Catalog</a></li>
      <li><a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a></li>
    </ul>
    
    <!-- Mobile Search -->
    <div class="mobile-search-luxe">
      <form action="{{ routes.search_url }}" method="get">
        <input type="search" name="q" placeholder="Search products" class="search-input-luxe">
        <button type="submit" class="search-btn-luxe">Search</button>
      </form>
    </div>
  </div>
</header>

{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Upload your logo (SVG or PNG recommended)"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "❤️ Spring Sale Now Live! ❤️"
    },
    {
      "type": "color",
      "id": "announcement_bg_color",
      "label": "Announcement background color",
      "default": "#a77049"
    }
  ]
}
{% endschema %}
