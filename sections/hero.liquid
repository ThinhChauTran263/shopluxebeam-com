<section class="hero luxebeam-hero" data-section-id="{{ section.id }}">
  <div class="hero__wrapper">
    {%- if section.settings.image != blank -%}
      <div class="hero__media">
        {{
          section.settings.image
          | image_url: width: 1920
          | image_tag:
            width: section.settings.image.width,
            height: section.settings.image.height,
            alt: section.settings.image.alt,
            class: 'hero__image',
            loading: 'eager'
        }}
      </div>
    {%- else -%}
      <div class="hero__media">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
      </div>
    {%- endif -%}
    
    {%- if section.settings.toggle_overlay -%}
      <div class="hero__overlay" style="background: {{ section.settings.overlay_color }};"></div>
    {%- endif -%}
    
    <div class="hero__content page-width">
      <div class="hero__text">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <div class="hero__text-block" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              <div class="hero__button-block" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" class="button luxebeam-button {{ block.settings.style_class }}">
                  {{ block.settings.label }}
                </a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wrapper {
    margin: 0;
    padding: 0;
    width: 100%;
  }
  
  .luxebeam-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin: 0;
    padding: 0;
  }
  
  .hero__wrapper {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 72px;
    margin: 0;
  }
  
  .hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    margin: 0;
    padding: 0;
  }
  
  .hero__image,
  .hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    margin: 0;
    padding: 0;
  }
  
  .hero__placeholder svg {
    width: 100%;
    height: 100%;
  }
  
  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  
  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    width: 100%;
    max-width: 1200px;
    padding: 0 20px;
    margin: 0 auto;
  }
  
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  
  .hero__text-block {
    margin: 0;
  }
  
  .hero__text-block h1,
  .hero__text-block h2,
  .hero__text-block h3 {
    font-size: 3.5rem;
    font-weight: bold;
    margin: 0;
    line-height: 1.1;
    color: white;
  }
  
  .hero__text-block p {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
    color: white;
  }
  
  .hero__button-block {
    margin: 0;
  }
  
  .button-secondary {
    background: transparent;
    border: 2px solid white;
    color: white;
    padding: 12px 32px;
    text-decoration: none;
    display: inline-block;
    border-radius: 4px;
    transition: all 0.3s ease;
    font-size: 1rem;
    font-weight: 500;
  }
  
  .button-secondary:hover {
    background: white;
    color: #000;
  }
  
  @media (max-width: 749px) {
    .hero__wrapper {
      min-height: 50vh;
      padding-bottom: 40px;
    }
    
    .hero__text-block h1,
    .hero__text-block h2,
    .hero__text-block h3 {
      font-size: 2rem;
    }
    
    .hero__text-block p {
      font-size: 1rem;
    }
    
    .hero__text {
      gap: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-wrapper section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#0a0a0a80"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<h1>Light Up Your Life with LuxeBeam</h1><p>Discover our curated collection of galaxy lights, RGB lighting, and mood lamps.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style_class",
          "label": "Button style",
          "options": [
            {
              "value": "button-primary",
              "label": "Primary"
            },
            {
              "value": "button-secondary",
              "label": "Secondary"
            }
          ],
          "default": "button-primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}