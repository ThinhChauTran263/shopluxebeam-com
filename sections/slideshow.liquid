{% comment %}
  Slideshow section - converted from existing HTML structure
{% endcomment %}

<section class="slider-content">
  <div class="slider-main">
    <div class="home-slider swiper" id="home-slider-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="slide-image">
              {% if block.settings.image_desktop != blank %}
                <img src="{{ block.settings.image_desktop | image_url: width: 1920 }}" 
                     srcset="{{ block.settings.image_desktop | image_url: width: 352 }} 352w,
                             {{ block.settings.image_desktop | image_url: width: 832 }} 832w,
                             {{ block.settings.image_desktop | image_url: width: 1200 }} 1200w,
                             {{ block.settings.image_desktop | image_url: width: 1920 }} 1920w" 
                     width="1920" 
                     height="757" 
                     loading="lazy" 
                     class="img-fluid desk-img"
                     alt="{{ block.settings.heading | escape }}">
              {% endif %}
              
              {% if block.settings.image_mobile != blank %}
                <img src="{{ block.settings.image_mobile | image_url: width: 1920 }}" 
                     srcset="{{ block.settings.image_mobile | image_url: width: 352 }} 352w,
                             {{ block.settings.image_mobile | image_url: width: 832 }} 832w,
                             {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w,
                             {{ block.settings.image_mobile | image_url: width: 1920 }} 1920w" 
                     width="1920" 
                     height="757" 
                     loading="lazy" 
                     class="img-fluid mobile-img"
                     alt="{{ block.settings.heading | escape }}">
              {% endif %}
              
              <div class="container slider-info-content">
                <div class="row">
                  <div class="col">
                    <div class="slider-text-info item-slide-{{ block.id }} slider-content-{{ block.settings.text_alignment }} slider-text-{{ block.settings.text_alignment }}">
                      {% if block.settings.subheading != blank %}
                        <span class="subtitle e1">
                          <h4 class="label">{{ block.settings.subheading }}</h4>
                          <span class="text"></span>
                        </span>
                      {% endif %}

                      {% if block.settings.heading != blank %}
                        <h2 class="e1">{{ block.settings.heading }}</h2>
                      {% endif %}

                      <div class="button-price e1">
                        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                          <a href="{{ block.settings.button_link }}" class="slider-btn btn btn-style">{{ block.settings.button_label }}</a>
                        {% endif %}
                        
                        {% if block.settings.custom_text != blank %}
                          <h4 class="custom-title">{{ block.settings.custom_text }}</h4>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <style data-shopify>
                .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info.item-slide-{{ block.id }} span.subtitle span.label {
                  color: {{ block.settings.subheading_color | default: '#ffffff' }};
                }
                .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info.item-slide-{{ block.id }} h2 {
                  color: {{ block.settings.heading_color | default: '#ffffff' }};
                }
                .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info.item-slide-{{ block.id }} .button-price h4.custom-title {
                  color: {{ block.settings.custom_text_color | default: '#ffffff' }};
                }
              </style>
            </div>
          </div>
        {% endfor %}
      </div>
      
      {% if section.blocks.size > 1 %}
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .slider-content {
    position: relative;
  }
  
  .slider-content .slider-main .home-slider {
    position: relative;
    overflow: hidden;
  }
  
  .slider-content .slider-main .home-slider .slide-image {
    position: relative;
  }
  
  .slider-content .slider-main .home-slider .slide-image img.mobile-img {
    display: none;
  }
  
  @media (max-width: 767px) {
    .slider-content .slider-main .home-slider .slide-image img.desk-img {
      display: none;
    }
    
    .slider-content .slider-main .home-slider .slide-image img.mobile-img {
      display: block;
    }
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 2;
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info {
    text-align: {{ section.settings.text_alignment | default: 'left' }};
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info.slider-content-center {
    text-align: center;
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info.slider-content-right {
    text-align: right;
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info h2 {
    font-size: 48px;
    line-height: 1.2;
    margin: 20px 0;
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info .subtitle h4 {
    font-size: 18px;
    margin-bottom: 10px;
  }
  
  .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info .button-price {
    margin-top: 30px;
  }
  
  @media (max-width: 767px) {
    .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info h2 {
      font-size: 28px;
    }
    
    .slider-content .slider-main .home-slider .slide-image .slider-info-content .slider-text-info .subtitle h4 {
      font-size: 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper = new Swiper('#home-slider-{{ section.id }}', {
      loop: true,
      autoplay: {
        delay: {{ section.settings.autoplay_delay | default: 5000 }},
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Text alignment"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3000,
      "max": 10000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay delay",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "Transform Every Corner of Your Home",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Upgrade Your Home with Smart, Stylish Improvements",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop Now",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "custom_text",
          "label": "Custom text"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subheading color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "custom_text_color",
          "label": "Custom text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left",
          "label": "Text alignment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}