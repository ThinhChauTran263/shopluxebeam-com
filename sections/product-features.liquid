{% comment %}
  Product Features Section - Displays product features using blocks
{% endcomment %}

{% if section.blocks.size > 0 %}
<section class="product-features-section">
  <div class="container">
    {% for block in section.blocks %}
      <div class="feature-row {% if forloop.index == 2 %}reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="feature-image">
          {% if block.settings.video_url != blank %}
            <div class="feature-video">
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
              {% endif %}
            </div>
          {% elsif block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" width="600" height="400" loading="lazy">
          {% else %}
            <div class="placeholder-image">
              <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#cccccc" stroke-width="1">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <p>{{ block.settings.title }}</p>
            </div>
          {% endif %}
        </div>
        <div class="feature-content">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<style>
.product-features-section {
  padding: 60px 0;
  background: #ffffff;
}

.feature-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  margin-bottom: 60px;
}

.feature-row:last-child {
  margin-bottom: 0;
}

.feature-row.reverse {
  direction: rtl;
}

.feature-row.reverse > * {
  direction: ltr;
}

.feature-image {
  border-radius: 12px;
  overflow: hidden;
  background: #f5f5f5;
  width: 100%;
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.feature-video {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.feature-video iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.placeholder-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 40px;
  text-align: center;
}

.placeholder-image p {
  color: #999999;
  font-size: 14px;
  margin: 0;
}

.feature-content h3 {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 15px;
  color: #000000;
}

.feature-content p {
  font-size: 16px;
  line-height: 1.6;
  color: #666666;
}

@media (max-width: 768px) {
  .feature-row {
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 40px;
  }
  
  .feature-row.reverse {
    direction: ltr;
  }
  
  .feature-content h3 {
    font-size: 22px;
  }
}
</style>

{% schema %}
{
  "name": "Product Features",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature Image"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Add YouTube or Vimeo video URL. Video will be used instead of image if provided."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Turns Hours of Scrubbing into Minutes"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "High-torque motor that spins the brush heads up to 350 RPM, breaking down soap scum, mildew, and grime without scrubbing by hand."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Features",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
