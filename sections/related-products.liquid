{% comment %}
  Related products section - shows products related to the current product
{% endcomment %}

{% assign related_products = product.related_products | default: collections[product.type].products %}
{% assign related_products = related_products | where: 'available' | limit: 4 %}

{% if related_products.size > 0 %}
  <div class="related-products section-ptb">
    <div class="container">
      <div class="section-capture">
        <div class="section-title">
          <h2>{{ 'products.product.related_products' | t }}</h2>
          <p class="desc">{{ 'products.product.related_products_description' | t }}</p>
        </div>
      </div>
      
      <div class="row">
        {% for related_product in related_products %}
          <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
            {% render 'product-card', product: related_product %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ]
}
{% endschema %}