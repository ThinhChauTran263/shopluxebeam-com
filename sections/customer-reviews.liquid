{% comment %}
  Customer Reviews Section
{% endcomment %}

<section class="customer-reviews-section">
  <div class="container">
    <h2 class="section-title">{{ section.settings.section_title }}</h2>
    
    <div class="reviews-summary">
      <div class="rating-overview">
        <div class="average-rating">
          <span class="rating-number">{{ section.settings.average_rating }}</span>
          <span class="rating-text">out of 5</span>
        </div>
        <div class="stars-large">
          {% assign rating_value = section.settings.average_rating | times: 10 | divided_by: 10.0 %}
          {% assign full_stars = rating_value | floor %}
          {% assign decimal = rating_value | minus: full_stars %}
          {% assign has_half_star = false %}
          {% if decimal >= 0.25 and decimal < 0.75 %}
            {% assign has_half_star = true %}
          {% elsif decimal >= 0.75 %}
            {% assign full_stars = full_stars | plus: 1 %}
          {% endif %}
          
          {% for i in (1..full_stars) %}
            <span class="star-full">★</span>
          {% endfor %}
          
          {% if has_half_star %}
            <span class="star-half">
              <span class="star-half-fill">★</span>
              <span class="star-half-empty">★</span>
            </span>
          {% endif %}
          
          {% assign empty_stars = 5 | minus: full_stars %}
          {% if has_half_star %}
            {% assign empty_stars = empty_stars | minus: 1 %}
          {% endif %}
          
          {% for i in (1..empty_stars) %}
            <span class="star-empty">☆</span>
          {% endfor %}
        </div>
        <p class="review-count">Based on {{ section.settings.total_reviews }} reviews</p>
        {% if section.settings.show_verified_link %}
        <a href="#" class="verified-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Verified Reviews
        </a>
        {% endif %}
      </div>
      
      <div class="rating-breakdown">
        <div class="rating-bar">
          <span class="stars-small">★★★★★</span>
          <div class="bar-container">
            <div class="bar-fill" style="width: {{ section.settings.rating_5_percent }}%"></div>
          </div>
          <span class="count">{{ section.settings.rating_5_count }}</span>
        </div>
        <div class="rating-bar">
          <span class="stars-small">★★★★☆</span>
          <div class="bar-container">
            <div class="bar-fill" style="width: {{ section.settings.rating_4_percent }}%"></div>
          </div>
          <span class="count">{{ section.settings.rating_4_count }}</span>
        </div>
        <div class="rating-bar">
          <span class="stars-small">★★★☆☆</span>
          <div class="bar-container">
            <div class="bar-fill" style="width: {{ section.settings.rating_3_percent }}%"></div>
          </div>
          <span class="count">{{ section.settings.rating_3_count }}</span>
        </div>
        <div class="rating-bar">
          <span class="stars-small">★★☆☆☆</span>
          <div class="bar-container">
            <div class="bar-fill" style="width: {{ section.settings.rating_2_percent }}%"></div>
          </div>
          <span class="count">{{ section.settings.rating_2_count }}</span>
        </div>
        <div class="rating-bar">
          <span class="stars-small">★☆☆☆☆</span>
          <div class="bar-container">
            <div class="bar-fill" style="width: {{ section.settings.rating_1_percent }}%"></div>
          </div>
          <span class="count">{{ section.settings.rating_1_count }}</span>
        </div>
      </div>
      
      <div class="write-review-cta">
        <button class="write-review-btn" style="background: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">{{ section.settings.button_text }}</button>
      </div>
    </div>
    
    <div class="reviews-filter">
      <button class="filter-btn active">{{ section.settings.filter_1_text }}</button>
      <button class="filter-btn">{{ section.settings.filter_2_text }}</button>
      <button class="filter-btn">{{ section.settings.filter_3_text }}</button>
    </div>
    
    <div class="reviews-list">
      {% for block in section.blocks %}
        <div class="review-card">
          <div class="review-header">
            <div class="reviewer-info">
              <div class="reviewer-avatar">{{ block.settings.reviewer_name | slice: 0 }}</div>
              <div>
                <div class="reviewer-name">{{ block.settings.reviewer_name }}</div>
                <div class="review-stars">★★★★★</div>
              </div>
            </div>
            <div class="review-date">{{ block.settings.review_date }}</div>
          </div>
          <div class="review-content">
            <h4 class="review-title">{{ block.settings.review_title }}</h4>
            <p class="review-text">{{ block.settings.review_text }}</p>
          </div>
          {% if block.settings.verified %}
            <div class="verified-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Verified Purchase
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.customer-reviews-section {
  padding: 80px 0;
  background: #ffffff;
}

.customer-reviews-section .section-title {
  text-align: center;
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 50px;
  color: #000000;
}

.reviews-summary {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;
  margin-bottom: 40px;
  padding: 40px;
  background: #f8f8f8;
  border-radius: 12px;
}

.rating-overview {
  text-align: center;
}

.average-rating {
  display: flex;
  flex-direction: column;
  margin-bottom: 10px;
}

.rating-number {
  font-size: 48px;
  font-weight: 700;
  color: #000000;
  line-height: 1;
}

.rating-text {
  font-size: 14px;
  color: #666666;
}

.stars-large {
  font-size: 24px;
  color: #ffa500;
  margin-bottom: 10px;
  display: flex;
  gap: 2px;
  justify-content: center;
}

.star-full {
  color: #ffa500;
}

.star-half {
  position: relative;
  display: inline-block;
  color: #ffa500;
}

.star-half-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  overflow: hidden;
  color: #ffa500;
}

.star-half-empty {
  color: #e0e0e0;
}

.star-empty {
  color: #e0e0e0;
}

.review-count {
  font-size: 14px;
  color: #666666;
  margin-bottom: 10px;
}

.verified-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #4caf50;
  font-size: 13px;
  text-decoration: none;
  font-weight: 600;
}

.rating-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.rating-bar {
  display: grid;
  grid-template-columns: 80px 1fr 40px;
  gap: 15px;
  align-items: center;
}

.stars-small {
  font-size: 14px;
  color: #ffa500;
}

.bar-container {
  height: 8px;
  background: #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #ffa500;
  transition: width 0.3s ease;
}

.rating-bar .count {
  text-align: right;
  font-size: 14px;
  color: #666666;
}

.write-review-cta {
  display: flex;
  align-items: center;
  justify-content: center;
}

.write-review-btn {
  background: #ffd700;
  color: #000000;
  border: none;
  padding: 15px 40px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
}

.write-review-btn:hover {
  background: #ffed4e;
  transform: translateY(-2px);
}

.reviews-filter {
  display: flex;
  gap: 15px;
  margin-bottom: 30px;
  justify-content: center;
}

.filter-btn {
  background: #ffffff;
  border: 2px solid #e0e0e0;
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  color: #666666;
}

.filter-btn:hover,
.filter-btn.active {
  background: #000000;
  color: #ffffff;
  border-color: #000000;
}

.reviews-list {
  display: grid;
  gap: 20px;
}

.review-card {
  background: #f8f8f8;
  padding: 25px;
  border-radius: 12px;
  border: 1px solid #e0e0e0;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15px;
}

.reviewer-info {
  display: flex;
  gap: 15px;
  align-items: center;
}

.reviewer-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #000000;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 700;
  text-transform: uppercase;
}

.reviewer-name {
  font-weight: 700;
  color: #000000;
  margin-bottom: 5px;
}

.review-stars {
  color: #ffa500;
  font-size: 14px;
}

.review-date {
  font-size: 13px;
  color: #999999;
}

.review-content {
  margin-bottom: 15px;
}

.review-title {
  font-size: 18px;
  font-weight: 700;
  color: #000000;
  margin-bottom: 10px;
}

.review-text {
  font-size: 15px;
  line-height: 1.6;
  color: #666666;
  margin: 0;
}

.verified-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #e8f5e9;
  color: #4caf50;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}

@media (max-width: 992px) {
  .reviews-summary {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .reviews-filter {
    flex-wrap: wrap;
  }
}

@media (max-width: 768px) {
  .customer-reviews-section {
    padding: 60px 0;
  }
  
  .customer-reviews-section .section-title {
    font-size: 28px;
  }
  
  .reviews-summary {
    padding: 25px;
  }
  
  .review-card {
    padding: 20px;
  }
  
  .reviewer-avatar {
    width: 40px;
    height: 40px;
    font-size: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Customer Reviews"
    },
    {
      "type": "header",
      "content": "Rating Summary"
    },
    {
      "type": "range",
      "id": "average_rating",
      "label": "Average rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.9,
      "info": "Drag to set rating (supports half stars: 4.5 shows 4 full stars + 1 half star)"
    },
    {
      "type": "number",
      "id": "total_reviews",
      "label": "Total number of reviews",
      "default": 98
    },
    {
      "type": "checkbox",
      "id": "show_verified_link",
      "label": "Show verified reviews link",
      "default": true
    },
    {
      "type": "header",
      "content": "Rating Breakdown"
    },
    {
      "type": "number",
      "id": "rating_5_count",
      "label": "5-star count",
      "default": 93
    },
    {
      "type": "range",
      "id": "rating_5_percent",
      "label": "5-star percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 95,
      "unit": "%"
    },
    {
      "type": "number",
      "id": "rating_4_count",
      "label": "4-star count",
      "default": 3
    },
    {
      "type": "range",
      "id": "rating_4_percent",
      "label": "4-star percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 3,
      "unit": "%"
    },
    {
      "type": "number",
      "id": "rating_3_count",
      "label": "3-star count",
      "default": 1
    },
    {
      "type": "range",
      "id": "rating_3_percent",
      "label": "3-star percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1,
      "unit": "%"
    },
    {
      "type": "number",
      "id": "rating_2_count",
      "label": "2-star count",
      "default": 1
    },
    {
      "type": "range",
      "id": "rating_2_percent",
      "label": "2-star percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1,
      "unit": "%"
    },
    {
      "type": "number",
      "id": "rating_1_count",
      "label": "1-star count",
      "default": 0
    },
    {
      "type": "range",
      "id": "rating_1_percent",
      "label": "1-star percentage",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Write Review Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Write a review"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#ffd700"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Filter Buttons"
    },
    {
      "type": "text",
      "id": "filter_1_text",
      "label": "Filter 1 text",
      "default": "Most Recent"
    },
    {
      "type": "text",
      "id": "filter_2_text",
      "label": "Filter 2 text",
      "default": "Highest Rating"
    },
    {
      "type": "text",
      "id": "filter_3_text",
      "label": "Filter 3 text",
      "default": "Lowest Rating"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "John D."
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date",
          "default": "2 days ago"
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review Title",
          "default": "Amazing product!"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "This product exceeded my expectations. Highly recommend!"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Purchase",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
