{% comment %}
  Collection Heading Section
  Displays collection title and description
{% endcomment %}

<div class="collection-heading section-ptb">
  <div class="container">
    <div class="collection-heading__content">
      <h1 class="collection-heading__title">{{ collection.title }}</h1>
      
      {% if collection.description != blank %}
        <div class="collection-heading__description">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .collection-heading {
    padding: 48px 0;
  }
  
  .collection-heading__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .collection-heading__title {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
    color: #000;
  }
  
  .collection-heading__description {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    max-width: 800px;
  }
  
  @media (max-width: 749px) {
    .collection-heading {
      padding: 32px 0;
    }
    
    .collection-heading__title {
      font-size: 1.5rem;
    }
    
    .collection-heading__description {
      font-size: 0.875rem;
    }
  }
</style>

{% schema %}
{
  "name": "Collection heading",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    }
  ]
}
{% endschema %}
