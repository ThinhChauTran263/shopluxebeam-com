{% comment %}
  Main page section - displays page content
{% endcomment %}

<div class="page-section section-ptb">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="page-content">
          <h1 class="page-title">{{ page.title }}</h1>
          
          {% if page.content != blank %}
            <div class="page-body">
              {{ page.content }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{{ 'main-page.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}