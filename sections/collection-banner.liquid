{% comment %}
  Collection banner section - displays collection title and featured image
{% endcomment %}

<div class="collection-banner">
  {% if collection.featured_image %}
    <div class="banner-image">
      <img src="{{ collection.featured_image | image_url: width: 1200 }}" 
           alt="{{ collection.title | escape }}"
           class="img-fluid">
      <div class="banner-overlay">
        <div class="container">
          <div class="banner-content">
            <h1 class="banner-title">{{ collection.title }}</h1>
            {% if collection.description != blank %}
              <p class="banner-description">{{ collection.description | strip_html | truncate: 200 }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="banner-text-only">
      <div class="container">
        <div class="text-center">
          <h1 class="banner-title">{{ collection.title }}</h1>
          {% if collection.description != blank %}
            <p class="banner-description">{{ collection.description | strip_html | truncate: 200 }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .collection-banner {
    position: relative;
    margin-bottom: 50px;
  }
  
  .banner-image {
    position: relative;
    height: 400px;
    overflow: hidden;
  }
  
  .banner-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .banner-content {
    text-align: center;
    color: white;
  }
  
  .banner-title {
    font-size: 3rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }
  
  .banner-description {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .banner-text-only {
    padding: 80px 0;
    background: var(--background-color-body);
  }
  
  .banner-text-only .banner-title {
    color: var(--font-color-header);
    font-size: 2.5rem;
  }
  
  .banner-text-only .banner-description {
    color: var(--font-color-paragraph);
    font-size: 1.1rem;
  }
  
  @media (max-width: 767px) {
    .banner-image {
      height: 250px;
    }
    
    .banner-title {
      font-size: 2rem !important;
    }
    
    .banner-description {
      font-size: 1rem !important;
    }
    
    .banner-text-only {
      padding: 50px 0;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height (px)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 400
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay on image",
      "default": true
    }
  ]
}
{% endschema %}