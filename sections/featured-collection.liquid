{% comment %}
  Featured collection section
{% endcomment %}

<section class="featured-collection section-ptb">
  <div class="container">
    <div class="section-header">
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.show_view_all and section.settings.collection != blank %}
        <a href="{{ collections[section.settings.collection].url }}" class="view-all-link">
          {{ section.settings.button_label | default: 'View all' }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      {% assign collection = collections[section.settings.collection] %}
      <div class="products-grid">
        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="product-grid-item">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="products-grid">
        {% for i in (1..section.settings.products_to_show) %}
          <div class="product-grid-item">
            {% render 'product-card', product: null %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .featured-collection {
    padding: 48px 0;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }
  
  .section-heading {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }
  
  .view-all-link {
    color: #000;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    transition: opacity 0.3s ease;
  }
  
  .view-all-link:hover {
    opacity: 0.7;
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  
  .products-grid .product-card {
    height: 450px;
  }
  
  .products-grid .product-card__image {
    height: 280px;
  }
  
  @media (max-width: 989px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    
    .products-grid .product-card {
      height: 420px;
    }
    
    .products-grid .product-card__image {
      height: 250px;
    }
  }
  
  @media (max-width: 749px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .products-grid .product-card {
      height: 380px;
    }
    
    .products-grid .product-card__image {
      height: 220px;
    }
    
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Products",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "View all",
      "label": "Button label"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}