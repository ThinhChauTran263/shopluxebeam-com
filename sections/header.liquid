}

.search-close-luxe:hover {
  color: #000;
}

.search-popup-body {
  padding: 20px 30px;
  max-height: 70vh;
  overflow-y: auto;
}

.search-section {
  margin-bottom: 25px;
}

.search-section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.section-header h3 {
  font-size: 18px;
  font-weight: 600;
  color: #666;
  margin: 0;
}

.clear-btn {
  background: none;
  border: none;
  color: #666;
  cursor: pointer;
  font-size: 14px;
  text-decoration: underline;
}

.clear-btn:hover {
  color: #000;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
