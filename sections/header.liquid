  align-items: center;
  gap: 20px;
  flex: 0 0 auto;
}

.search-toggle-luxe,
.cart-link-luxe,
.account-link-luxe {
  color: #000000;
  text-decoration: none;
  display: flex;
  align-items: center;
  transition: color 0.3s ease;
  background: none;
  border: none;
  cursor: pointer;
}

.search-toggle-luxe:hover,
.cart-link-luxe:hover,
.account-link-luxe:hover {
  color: #666666;
}

.cart-count-luxe {
  margin-left: 5px;
  font-size: 14px;
  font-weight: 500;
}

/* Mobile Toggle */
.mobile-toggle-luxe {
  display: none;
  flex-direction: column;
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
}

.mobile-toggle-luxe span {
  width: 25px;
  height: 3px;
  background: #000000;
  margin: 3px 0;
  transition: 0.3s;
}

/* Mobile Menu */
.mobile-menu-luxe {
  display: none;
  background: #ffffff;
  border-top: 1px solid #e0e0e0;
  padding: 20px 0;
}

.mobile-nav-luxe {
  list-style: none;
  margin: 0;
  padding: 0;
}

.mobile-nav-luxe li {
  border-bottom: 1px solid #f0f0f0;
}

.mobile-nav-luxe a {
  display: block;
  padding: 15px 0;
  color: #000000;
  text-decoration: none;
  font-weight: 500;
}

.mobile-search-luxe {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #f0f0f0;
}

.mobile-search-luxe form {
  display: flex;
  gap: 10px;
}

.search-input-luxe {
  flex: 1;
  padding: 10px 15px;
  border: 1px solid #e0e0e0;
