}

/* Mobile Menu */
.mobile-menu-luxe {
  display: none;
  background: #ffffff;
  border-top: 1px solid #e0e0e0;
  padding: 20px 0;
}

.mobile-nav-luxe {
  list-style: none;
  margin: 0;
  padding: 0;
}

.mobile-nav-luxe li {
  border-bottom: 1px solid #f0f0f0;
}

.mobile-nav-luxe a {
