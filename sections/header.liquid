/* Responsive */
@media (max-width: 768px) {
  .main-navigation-luxe {
    display: none;
  }
  
  .mobile-toggle-luxe {
    display: flex;
  }
  
  .mobile-menu-luxe.active {
    display: block;
  }
  
  .header-actions-luxe {
    gap: 15px;
  }
  
  .header-logo-luxe {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  
  .header-logo-luxe .logo-img {
    max-height: 50px;
  }
}

@media (max-width: 480px) {
  .header-actions-luxe {
    gap: 10px;
  }
  
  .header-logo-luxe .logo-img {
    max-height: 45px;
  }
