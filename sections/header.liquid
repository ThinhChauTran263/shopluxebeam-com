/* Account Button Styles */
.account-button-luxe {
  display: flex;
  align-items: center;
}

shopify-account {
  --shopify-account-font-heading: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --shopify-account-font-heading-weight: 600;
  --shopify-account-font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --shopify-account-font-body-weight: 400;
  --shopify-account-radius-base: 8px;
  --shopify-account-radius-button: 4px;
  --shopify-account-radius-button-small: 4px;
  --shopify-account-radius-input: 4px;
  --shopify-account-color-background: #ffffff;
  --shopify-account-color-text: #000000;
  --shopify-account-color-accent: #000000;
  --shopify-account-color-accent-text: #ffffff;
  --shopify-account-dialog-position-top: 80px;
}

shopify-account:not(:defined) {
  min-width: 20px;
  height: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.account-button__fallback {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background-color: #000000;
}

/* Cart Bubble Styles */
.cart-bubble {
  --cart-bubble-size: 18px;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--cart-bubble-size);
  height: var(--cart-bubble-size);
  border-radius: 50%;
  font-size: 11px;
  font-weight: 600;
  line-height: 1;
}

.cart-bubble__background {
  position: absolute;
  inset: 0;
  background-color: #000000;
  border-radius: 50%;
}

.cart-bubble__text {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
}

.cart-bubble__text-count {
  display: block;
}

.cart-bubble.visually-hidden {
  opacity: 0;
  visibility: hidden;
}

.cart-bubble--animating .cart-bubble__background {
  animation: cart-bubble-grow 0.3s ease;
}

.cart-bubble--animating .cart-bubble__text {
  animation: cart-bubble-text-fade 0.3s ease;
}

@keyframes cart-bubble-grow {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

@keyframes cart-bubble-text-fade {
  0% { opacity: 1; }
  50% { opacity: 0.7; }
  100% { opacity: 1; }
}

/* Utility classes */
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.hidden {
  display: none !important;
}

/* Search Popup Styles */
.search-popup-luxe {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.search-popup-luxe.active {
