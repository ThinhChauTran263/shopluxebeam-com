  }
  
  .original-price {
    font-size: 11px;
  }
}
</style>

<!-- Search Popup Fix CSS -->
<link rel="stylesheet" href="{{ 'search-popup-fix.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'header-actions.css' | asset_url }}">

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const mobileToggle = document.querySelector('.mobile-toggle-luxe');
    const mobileMenu = document.querySelector('.mobile-menu-luxe');
    
    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', function() {
        mobileMenu.classList.toggle('active');
        this.classList.toggle('active');
      });
    }

    // Search popup functionality
    const searchToggle = document.querySelector('.search-toggle-luxe');
    const searchPopup = document.getElementById('searchPopup');
    const searchClose = document.querySelector('.search-close-luxe');
    const searchInput = document.getElementById('searchInput');
    const searchResultsSection = document.getElementById('searchResultsSection');
    const searchResultsGrid = document.getElementById('searchResultsGrid');
    const recentlyViewedGrid = document.getElementById('recentlyViewedGrid');
    const allProductsGrid = document.getElementById('allProductsGrid');

    // Open search popup
    if (searchToggle) {
      searchToggle.addEventListener('click', function() {
        searchPopup.classList.add('active');
        document.body.style.overflow = 'hidden';
        setTimeout(() => searchInput.focus(), 300);
        
        // Store original products HTML if not already stored
        if (!originalProductsHTML) {
          originalProductsHTML = allProductsGrid.innerHTML;
        }
        
        loadRecentlyViewed();
        loadAllProductsData(); // Load all products for search filtering
        
        // Ensure products are displayed
        if (allProductsGrid.innerHTML.trim() === '' || allProductsGrid.innerHTML.includes('No products found')) {
          loadOriginalProducts();
        }
        
        console.log('Search popup opened');
      });
    }

    // Close search popup
    if (searchClose) {
      searchClose.addEventListener('click', closeSearchPopup);
    }

    // Close on overlay click
    if (searchPopup) {
      searchPopup.addEventListener('click', function(e) {
        if (e.target === searchPopup) {
          closeSearchPopup();
        }
      });
    }

    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchPopup.classList.contains('active')) {
        closeSearchPopup();
      }
    });

    function closeSearchPopup() {
      searchPopup.classList.remove('active');
      document.body.style.overflow = '';
      searchInput.value = '';
      
      // Reset sections visibility
      document.querySelector('.recently-viewed-section').style.display = 'block';
      document.querySelector('.products-section .section-header h3').textContent = 'Products';
      
      // Restore original products
      restoreOriginalProducts();
    }

    // Search functionality
    let searchTimeout;
    let allProductsData = []; // Store all products for filtering
    let originalProductsHTML = ''; // Store original HTML
    
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        const query = this.value.trim();
        
        if (query.length > 0) {
          // Hide recently viewed section when searching
          document.querySelector('.recently-viewed-section').style.display = 'none';
          // Show only products section
          document.querySelector('.products-section .section-header h3').textContent = 'Search Results';
          
          searchTimeout = setTimeout(() => performLocalSearch(query), 100);
        } else {
          // Show recently viewed section when not searching
          document.querySelector('.recently-viewed-section').style.display = 'block';
          document.querySelector('.products-section .section-header h3').textContent = 'Products';
          
          // Restore original products
          restoreOriginalProducts();
        }
      });
    }

    function performLocalSearch(query) {
      if (allProductsData.length === 0) {
        // If we don't have products data yet, load it first
        loadAllProductsForSearch(query);
        return;
      }
      
      // Filter products locally - exact match and partial match
      const filteredProducts = allProductsData.filter(product => {
        const title = (product.title || '').toLowerCase();
        const searchQuery = query.toLowerCase();
        return title.includes(searchQuery);
      });
      
      console.log(`Search "${query}" found ${filteredProducts.length} products`);
      displayFilteredProducts(filteredProducts);
    }

    function loadAllProductsForSearch(query) {
      allProductsGrid.innerHTML = '<div class="loading-message">Searching...</div>';
      
      // Load all products first
      fetch('/collections/all/products.json?limit=100')
        .then(response => {
          if (!response.ok) {
            return fetch('/search.json?q=*&type=product&limit=100');
          }
          return response;
        })
        .then(response => response.json())
        .then(data => {
          allProductsData = data.products || [];
          console.log('Loaded products for search:', allProductsData.length);
          // Now perform the search
          performLocalSearch(query);
        })
        .catch(error => {
          console.error('Error loading products for search:', error);
          allProductsGrid.innerHTML = '<div class="loading-message">Search failed. Please try again.</div>';
        });
    }

    function displayFilteredProducts(products) {
      if (products.length === 0) {
        allProductsGrid.innerHTML = '<div class="loading-message">No products found.</div>';
        return;
      }

      const productsHTML = products.map(product => createProductCard(product)).join('');
      allProductsGrid.innerHTML = productsHTML;
    }

    function restoreOriginalProducts() {
      console.log('Restoring original products');
      if (originalProductsHTML) {
        allProductsGrid.innerHTML = originalProductsHTML;
      } else if (allProductsData.length > 0) {
        // Fallback: show first 8 products
        const originalProductsHTML = allProductsData.slice(0, 8).map(product => createProductCard(product)).join('');
        allProductsGrid.innerHTML = originalProductsHTML;
      } else {
        // Load original products
        loadOriginalProducts();
      }
    }

    function loadOriginalProducts() {
      fetch('/collections/all/products.json?limit=8')
        .then(response => response.json())
        .then(data => {
          const products = data.products || [];
          const productsHTML = products.map(product => createProductCard(product)).join('');
          allProductsGrid.innerHTML = productsHTML;
          originalProductsHTML = productsHTML; // Store for future use
        })
        .catch(error => {
          console.error('Error loading original products:', error);
          allProductsGrid.innerHTML = '<div class="loading-message">Failed to load products.</div>';
        });
    }

    function performSearch(query) {
      searchResultsGrid.innerHTML = '<div class="loading-message">Searching...</div>';
      
      // Use Shopify's search endpoint
      fetch(`/search?q=${encodeURIComponent(query)}&type=product&view=json`)
        .then(response => {
          if (!response.ok) {
            // Fallback to predictive search
            return fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=8`);
          }
          return response;
        })
        .then(response => response.json())
        .then(data => {
          let products = [];
          
          // Handle different response formats
          if (data.resources && data.resources.results && data.resources.results.products) {
            products = data.resources.results.products;
          } else if (data.products) {
            products = data.products;
          } else if (Array.isArray(data)) {
            products = data;
          }
          
          displaySearchResults(products);
        })
        .catch(error => {
          console.error('Search error:', error);
          // Final fallback - simple search
          performSimpleSearch(query);
        });
    }

    function performSimpleSearch(query) {
      fetch(`/search.json?q=${encodeURIComponent(query)}&type=product`)
        .then(response => response.json())
        .then(data => {
          const products = data.results || data.products || [];
          displaySearchResults(products.slice(0, 8));
        })
        .catch(error => {
          console.error('Simple search failed:', error);
          searchResultsGrid.innerHTML = '<div class="loading-message">Search unavailable. Please try again later.</div>';
        });
    }

    function displaySearchResults(products) {
      if (products.length === 0) {
        searchResultsGrid.innerHTML = '<div class="loading-message">No products found.</div>';
        return;
      }

      const productsHTML = products.map(product => createProductCard(product)).join('');
      searchResultsGrid.innerHTML = productsHTML;
    }

    function loadAllProductsData() {
      // Load all products in background for search functionality
      fetch('/collections/all/products.json?limit=50')
        .then(response => {
          if (!response.ok) {
            return fetch('/search.json?q=*&type=product&limit=50');
          }
          return response;
        })
        .then(response => response.json())
        .then(data => {
          allProductsData = data.products || [];
          console.log('Loaded', allProductsData.length, 'products for search');
        })
        .catch(error => {
          console.error('Error loading products data:', error);
        });
    }

    function loadRecentlyViewed() {
      const recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
      
      if (recentlyViewed.length === 0) {
        recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
        return;
      }

      // Get product details for recently viewed items
      const productPromises = recentlyViewed.slice(0, 4).map(productId => 
        fetch(`/products/${productId}.js`).then(r => r.json()).catch(() => null)
      );

      Promise.all(productPromises).then(products => {
        const validProducts = products.filter(p => p !== null);
        const productsHTML = validProducts.map(product => createProductCard(product)).join('');
        recentlyViewedGrid.innerHTML = productsHTML || '<div class="loading-message">No recently viewed products.</div>';
      });
    }

    function loadAllProducts() {
      allProductsGrid.innerHTML = '<div class="loading-message">Loading products...</div>';
      console.log('Loading products...');
      
      // Try different endpoints for loading products
      fetch('/collections/all/products.json?limit=8')
        .then(response => {
          console.log('First fetch response:', response.status, response.statusText);
          if (!response.ok) {
            // Fallback to search endpoint
            console.log('Trying fallback search...');
            return fetch('/search.json?q=*&type=product&limit=8');
          }
          return response;
        })
        .then(response => {
          console.log('Second fetch response:', response.status, response.statusText);
          return response.json();
        })
        .then(data => {
          console.log('Products data received:', data);
          const products = data.products || [];
          if (products.length === 0) {
            console.log('No products found, trying collections...');
            loadProductsFromCollections();
            return;
          }
          const productsHTML = products.map(product => createProductCard(product)).join('');
          allProductsGrid.innerHTML = productsHTML;
        })
        .catch(error => {
          console.error('Error loading products:', error);
          // Final fallback - try to get products from collections
          loadProductsFromCollections();
        });
    }

    function loadProductsFromCollections() {
      fetch('/collections.json')
        .then(response => response.json())
        .then(data => {
          if (data.collections && data.collections.length > 0) {
            const firstCollection = data.collections[0];
            return fetch(`/collections/${firstCollection.handle}/products.json?limit=8`);
          }
          throw new Error('No collections found');
        })
        .then(response => response.json())
        .then(data => {
          const products = data.products || [];
          if (products.length === 0) {
            allProductsGrid.innerHTML = '<div class="loading-message">No products available.</div>';
            return;
          }
          const productsHTML = products.map(product => createProductCard(product)).join('');
          allProductsGrid.innerHTML = productsHTML;
        })
        .catch(error => {
          console.error('Final fallback failed:', error);
          allProductsGrid.innerHTML = '<div class="loading-message">Unable to load products.</div>';
        });
    }

    function createProductCard(product) {
      // Handle different product data formats
      const title = product.title || product.name || 'Untitled Product';
      const handle = product.handle || product.url || '#';
      
      // Handle images
      let imageUrl = '';
      if (product.images && product.images.length > 0) {
        imageUrl = product.images[0];
      } else if (product.featured_image) {
        imageUrl = product.featured_image;
      } else if (product.image) {
        imageUrl = product.image;
      }
      
      // Ensure proper image size
      if (imageUrl && !imageUrl.includes('_200x200')) {
        imageUrl = imageUrl.replace(/\.(jpg|jpeg|png|webp)/i, '_200x200.$1');
      }
      
      // Handle pricing
      let price = '0.00';
      let comparePrice = null;
      
      if (product.price) {
        price = typeof product.price === 'number' ? 
          (product.price / 100).toFixed(2) : 
          parseFloat(product.price).toFixed(2);
      } else if (product.price_min) {
        price = typeof product.price_min === 'number' ? 
          (product.price_min / 100).toFixed(2) : 
          parseFloat(product.price_min).toFixed(2);
      }
      
      if (product.compare_at_price && product.compare_at_price > (product.price || product.price_min)) {
        comparePrice = typeof product.compare_at_price === 'number' ? 
          (product.compare_at_price / 100).toFixed(2) : 
          parseFloat(product.compare_at_price).toFixed(2);
      } else if (product.compare_at_price_max && product.compare_at_price_max > (product.price || product.price_min)) {
        comparePrice = typeof product.compare_at_price_max === 'number' ? 
          (product.compare_at_price_max / 100).toFixed(2) : 
          parseFloat(product.compare_at_price_max).toFixed(2);
      }

      return `
        <div class="product-card" onclick="goToProduct('${handle}')">
          ${imageUrl ? `<img src="${imageUrl}" alt="${title}" class="product-image" onerror="this.style.display='none'">` : '<div class="product-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">No Image</div>'}
          <div class="product-info">
            <h4 class="product-title">${title}</h4>
            <div class="product-price">
              <span class="current-price">$${price}</span>
              ${comparePrice ? `<span class="original-price">$${comparePrice}</span>` : ''}
            </div>
          </div>
        </div>
      `;
    }

    // Global functions
    window.goToProduct = function(handle) {
      // Save to recently viewed
      let recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
      recentlyViewed = recentlyViewed.filter(id => id !== handle);
      recentlyViewed.unshift(handle);
      recentlyViewed = recentlyViewed.slice(0, 10); // Keep only last 10
      localStorage.setItem('recentlyViewed', JSON.stringify(recentlyViewed));
      
      // Navigate to product
      window.location.href = `/products/${handle}`;
    };

    window.clearRecentlyViewed = function() {
      localStorage.removeItem('recentlyViewed');
      recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
    };
  });
</script>

