  --shopify-account-radius-button-small: 4px;
  --shopify-account-radius-input: 4px;
  --shopify-account-color-background: #ffffff;
  --shopify-account-color-text: #000000;
  --shopify-account-color-accent: #000000;
  --shopify-account-color-accent-text: #ffffff;
  --shopify-account-dialog-position-top: 80px;
}

shopify-account:not(:defined) {
  min-width: 20px;
  height: 20px;
