  }
  
  .cart-count-luxe {
    font-size: 12px;
  }
  
  .search-popup-luxe {
    background: rgba(0, 0, 0, 0); /* Remove dark overlay on mobile */
  }
  
  .search-popup-content {
    width: 100%;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    border-radius: 0;
    max-width: 100%;
  }
  
  .search-popup-header {
    padding: 12px;
    border-bottom: 1px solid #e0e0e0;
  }
  
  .search-input-popup {
    padding: 10px 10px 10px 40px;
    font-size: 14px;
  }
  
  .search-popup-body {
    padding: 12px;
    max-height: calc(100vh - 50px);
  }
  
  .products-grid {
    gap: 8px;
  }
  
  .product-image {
    height: 100px;
  }
  
  .product-title {
    font-size: 10px;
    height: 24px;
  }
  
  .current-price {
    font-size: 11px;
  }
}

/* Account Button Styles */
.account-button-luxe {
  display: flex;
  align-items: center;
}

shopify-account {
  --shopify-account-font-heading: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --shopify-account-font-heading-weight: 600;
  --shopify-account-font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
