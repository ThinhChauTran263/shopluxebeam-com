.search-popup-header {
  display: flex;
  align-items: center;
  padding: 20px 30px;
  border-bottom: 1px solid #e0e0e0;
  gap: 20px;
}

.search-input-container {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 15px;
