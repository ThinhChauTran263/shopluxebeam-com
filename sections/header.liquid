  justify-content: center;
  align-items: center;
}

.account-button__fallback {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background-color: #000000;
}
</style>

<script src="{{ 'search-popup.js' | asset_url }}" defer></script>

<script>
// Mobile menu toggle
document.addEventListener('DOMContentLoaded', function() {
  const mobileToggle = document.querySelector('.mobile-toggle-luxe');
  const mobileMenu = document.querySelector('.mobile-menu-luxe');
  
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', function() {
      mobileMenu.classList.toggle('active');
      this.classList.toggle('active');
    });
  }

  // Search popup functionality
  const searchToggle = document.querySelector('.search-toggle-luxe');
  const searchPopup = document.getElementById('searchPopup');
  const searchClose = document.querySelector('.search-close-luxe');
  const searchInput = document.getElementById('searchInput');
  const recentlyViewedGrid = document.getElementById('recentlyViewedGrid');
  const allProductsGrid = document.getElementById('allProductsGrid');

  // Debug: Check if elements exist
  console.log('Search elements found:', {
    searchToggle: !!searchToggle,
    searchPopup: !!searchPopup,
    searchClose: !!searchClose,
    searchInput: !!searchInput,
    recentlyViewedGrid: !!recentlyViewedGrid,
    allProductsGrid: !!allProductsGrid
  });

  // Recently viewed products functionality
  class RecentlyViewed {
    static STORAGE_KEY = 'recentlyViewed';
    static MAX_PRODUCTS = 4;
    
    static addProduct(productHandle) {
      let viewedProducts = this.getProducts();
      viewedProducts = viewedProducts.filter(handle => handle !== productHandle);
      viewedProducts.unshift(productHandle);
      viewedProducts = viewedProducts.slice(0, this.MAX_PRODUCTS);
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(viewedProducts));
    }
    
    static getProducts() {
      return JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '[]');
    }
    
    static clearProducts() {
      localStorage.removeItem(this.STORAGE_KEY);
    }
  }

  // Search toggle - Open popup for both desktop and mobile
  if (searchToggle) {
    searchToggle.addEventListener('click', function() {
      console.log('Opening search popup...');
      searchPopup.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput.focus(), 300);
      
      loadRecentlyViewed();
      loadAllProducts();
      
      console.log('Search popup opened successfully');
    });
  }

  // Close search popup
  if (searchClose) {
    searchClose.addEventListener('click', closeSearchPopup);
  }

  // Close on overlay click
  if (searchPopup) {
    searchPopup.addEventListener('click', function(e) {
      if (e.target === searchPopup) {
        closeSearchPopup();
      }
    });
  }

  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && searchPopup.classList.contains('active')) {
      closeSearchPopup();
    }
  });

  function closeSearchPopup() {
    searchPopup.classList.remove('active');
    document.body.style.overflow = '';
    searchInput.value = '';
    
    // Reset sections visibility
    document.querySelector('.recently-viewed-section').style.display = 'block';
    document.querySelector('.products-section .section-header h3').textContent = 'Products';
    
    // Restore original products
    loadAllProducts();
  }

  // Simple search functionality
  let searchTimeout;
  let allProductsCache = []; // Cache ALL products for quick restore
  let isSearching = false; // Flag to track if search is in progress
  
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      const query = this.value.trim();
      
      if (query.length > 0) {
        // Hide recently viewed section when searching
        document.querySelector('.recently-viewed-section').style.display = 'none';
        // Show only products section
        document.querySelector('.products-section .section-header h3').textContent = 'Search Results';
        
        isSearching = true;
        searchTimeout = setTimeout(() => performSearch(query), 300);
      } else {
        // Cancel any pending search
        isSearching = false;
        
        // Show recently viewed section when not searching
        document.querySelector('.recently-viewed-section').style.display = 'block';
        document.querySelector('.products-section .section-header h3').textContent = 'Products';
        
        // Always restore ALL products when clearing search - no delay
        if (allProductsCache.length > 0) {
          // Use cached all products immediately
          const productsHTML = allProductsCache.map(product => window.createProductCard(product)).join('');
          allProductsGrid.innerHTML = productsHTML;
        } else {
          // Show loading and load all products
          allProductsGrid.innerHTML = '<div class="loading-message">Loading products...</div>';
          loadAllProducts();
        }
      }
    });
  }

  function performSearch(query) {
    allProductsGrid.innerHTML = '<div class="loading-message">Searching...</div>';
    
    // Use manual search first for better results
    searchSimple(query);
  }
  
  function searchWithShopifyAPI(query) {
    console.log('Searching with Shopify API for:', query);
    
    // Use Shopify's search endpoint
    fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=50`)
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.resources?.results?.products || [];
        if (products.length > 0) {
          console.log(`Found ${products.length} products via search API`);
          displaySearchResults(products);
        } else {
          // Fallback to manual search
          searchSimple(query);
        }
      })
      .catch(error => {
        console.error('Search API failed:', error);
        // Fallback to manual search
        searchSimple(query);
      });
  }
  
  function searchSimple(query) {
    console.log('Simple search for:', query);
    
    // Try products.json first, then collections
    trySearchInProducts(query)
      .catch(() => trySearchInAllCollection(query))
      .catch(() => trySearchInCollections(query))
      .catch(() => {
        // Only show error if still searching (user hasn't cleared input)
        if (isSearching) {
          console.error('All search methods failed');
          allProductsGrid.innerHTML = `<div class="loading-message">No results found for "${query}".</div>`;
        }
      });
  }
  
  function trySearchInProducts(query) {
    return fetch('/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        if (filteredProducts.length > 0) {
          console.log(`Found ${filteredProducts.length} products in products.json`);
          displaySearchResults(filteredProducts);
          return filteredProducts;
        } else {
          throw new Error('No matching products found');
        }
      });
  }
  
  function trySearchInAllCollection(query) {
    return fetch('/collections/all/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        if (filteredProducts.length > 0) {
          console.log(`Found ${filteredProducts.length} products in all collection`);
          displaySearchResults(filteredProducts);
          return filteredProducts;
        } else {
          throw new Error('No matching products found');
        }
      });
  }
  
  function trySearchInCollections(query) {
    return fetch('/collections.json')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const collections = data.collections || [];
        if (collections.length === 0) throw new Error('No collections found');
        
        return searchInMultipleCollections(collections.slice(0, 5), query, []);
      });
  }
  
  function searchInMultipleCollections(collections, query, allResults) {
    if (collections.length === 0) {
      if (allResults.length > 0) {
        displaySearchResults(allResults);
        return allResults;
      } else {
        throw new Error('No results found');
      }
    }
    
    const collection = collections[0];
    const remainingCollections = collections.slice(1);
    
    return fetch(`/collections/${collection.handle}/products.json?limit=20`)
      .then(response => response.ok ? response.json() : { products: [] })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        console.log(`Found ${filteredProducts.length} products in ${collection.handle}`);
        allResults.push(...filteredProducts);
        
        return searchInMultipleCollections(remainingCollections, query, allResults);
      })
      .catch(error => {
        console.error(`Error searching in ${collection.handle}:`, error);
        return searchInMultipleCollections(remainingCollections, query, allResults);
      });
  }
  
  function filterProductsByQuery(products, query) {
    if (!query || query.trim() === '') return products;
    
    return products.filter(product => {
      const title = (product.title || '').toLowerCase();
      const vendor = (product.vendor || '').toLowerCase();
      const productType = (product.product_type || '').toLowerCase();
      const tags = (product.tags || []).join(' ').toLowerCase();
      const searchQuery = query.toLowerCase().trim();
      
      // Search in title, vendor, product type, and tags
      const searchableText = `${title} ${vendor} ${productType} ${tags}`;
      
      // Direct substring match - most common case
      if (searchableText.includes(searchQuery)) {
        return true;
      }
      
      // Word-by-word match for multi-word queries
      const queryWords = searchQuery.split(/\s+/).filter(word => word.length > 0);
      if (queryWords.length > 1) {
        // All words must be found somewhere in searchable text
        return queryWords.every(queryWord => searchableText.includes(queryWord));
      }
      
      // Partial word match - check if query matches start of any word
      const words = searchableText.split(/\s+/);
      return words.some(word => word.startsWith(searchQuery));
    });
  }

  function displaySearchResults(products) {
    // Only update if still searching (user hasn't cleared input)
    if (!isSearching) {
      return;
    }
    
    if (products.length === 0) {
      allProductsGrid.innerHTML = '<div class="loading-message">No products found.</div>';
      return;
    }

    // Update section header with result count
    const sectionHeader = document.querySelector('.products-section .section-header h3');
    if (sectionHeader) {
      const query = document.getElementById('searchInput').value.trim();
      if (query) {
        sectionHeader.textContent = `Search Results (${products.length})`;
      } else {
        sectionHeader.textContent = 'Products';
      }
    }

    const productsHTML = products.map(product => window.createProductCard(product)).join('');
    allProductsGrid.innerHTML = productsHTML;
  }

  function loadRecentlyViewed() {
    const recentlyViewed = RecentlyViewed.getProducts();
    
    if (recentlyViewed.length === 0) {
      recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
      return;
    }

    // Get product details for recently viewed items
    const productPromises = recentlyViewed.slice(0, 4).map(productHandle => 
      fetch(`/products/${productHandle}.js`).then(r => r.json()).catch(() => null)
    );

    Promise.all(productPromises).then(products => {
      const validProducts = products.filter(p => p !== null);
      const productsHTML = validProducts.map(product => window.createProductCard(product)).join('');
      recentlyViewedGrid.innerHTML = productsHTML || '<div class="loading-message">No recently viewed products.</div>';
    });
  }

  function loadAllProducts() {
    allProductsGrid.innerHTML = '<div class="loading-message">Loading products...</div>';
    
    // Simple approach: just try to get any products that work
    loadProductsSimple();
  }
  
  function loadProductsSimple() {
    console.log('Loading products...');
    
    // Try multiple approaches in sequence
    tryLoadFromAllCollection()
      .catch(() => tryLoadFromCollections())
      .catch(() => tryLoadFromRecentlyViewed())
      .catch(() => showFallbackMessage());
  }
  
  function tryLoadFromAllCollection() {
    // Try different endpoints
    return fetch('/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        if (products.length === 0) throw new Error('No products found');
        
        console.log(`Loaded ${products.length} products from products.json`);
        allProductsCache = products; // Cache ALL products
        const productsHTML = products.map(product => window.createProductCard(product)).join('');
        allProductsGrid.innerHTML = productsHTML;
        return products;
      })
      .catch(error => {
        console.error('products.json failed, trying collections/all:', error);
        return fetch('/collections/all/products.json?limit=50')
          .then(response => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then(data => {
            const products = data.products || [];
            if (products.length === 0) throw new Error('No products found');
            
            console.log(`Loaded ${products.length} products from all collection`);
            allProductsCache = products; // Cache ALL products
            const productsHTML = products.map(product => window.createProductCard(product)).join('');
            allProductsGrid.innerHTML = productsHTML;
            return products;
          });
      });
  }
  
  function tryLoadFromCollections() {
    return fetch('/collections.json')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const collections = data.collections || [];
        if (collections.length === 0) throw new Error('No collections found');
        
        // Find a collection with products
        const validCollections = collections.filter(c => c.products_count > 0);
        const targetCollection = validCollections.length > 0 ? validCollections[0] : collections[0];
        
        return fetch(`/collections/${targetCollection.handle}/products.json?limit=8`)
          .then(response => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then(data => {
            const products = data.products || [];
            if (products.length === 0) throw new Error('No products in collection');
            
            console.log(`Loaded ${products.length} products from ${targetCollection.handle}`);
            allProductsCache = products; // Cache ALL products
            const productsHTML = products.map(product => window.createProductCard(product)).join('');
            allProductsGrid.innerHTML = productsHTML;
            return products;
          });
      });
  }
  
  function tryLoadFromRecentlyViewed() {
    const recentlyViewed = RecentlyViewed.getProducts();
    
    if (recentlyViewed.length === 0) {
      throw new Error('No recently viewed products');
    }
    
    console.log('Loading recently viewed as fallback');
    
    const productPromises = recentlyViewed.slice(0, 8).map(productHandle => 
      fetch(`/products/${productHandle}.js`)
        .then(r => r.ok ? r.json() : null)
        .catch(() => null)
    );

    return Promise.all(productPromises).then(products => {
      const validProducts = products.filter(p => p !== null);
      
      if (validProducts.length === 0) {
        throw new Error('No valid recently viewed products');
      }
      
      console.log(`Showing ${validProducts.length} recently viewed products`);
      allProductsCache = validProducts; // Cache ALL products
      const productsHTML = validProducts.map(product => window.createProductCard(product)).join('');
      allProductsGrid.innerHTML = productsHTML;
      return validProducts;
    });
  }
  
  function showFallbackMessage() {
    console.log('All product loading methods failed, showing fallback');
    allProductsGrid.innerHTML = `
      <div class="loading-message">
        <p>Browse our products</p>
        <a href="/collections/all" style="color: #000; text-decoration: underline; font-weight: 600;">View All Products â†’</a>
      </div>
    `;
  }

  // Use createProductCard from search-popup.js file
  // Old function removed due to encoding issues

  // Global functions
  window.goToProduct = function(handle) {
    if (handle && handle !== '#') {
      RecentlyViewed.addProduct(handle);
      window.location.href = `/products/${handle}`;
    }
  };

  window.clearRecentlyViewed = function() {
    RecentlyViewed.clearProducts();
    recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
  };
});
</script>

