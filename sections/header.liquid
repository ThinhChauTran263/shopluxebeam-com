<script src="{{ 'search-popup.js' | asset_url }}" defer></script>

<script>
// Mobile menu toggle
document.addEventListener('DOMContentLoaded', function() {
  const mobileToggle = document.querySelector('.mobile-toggle-luxe');
  const mobileMenu = document.querySelector('.mobile-menu-luxe');
  
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', function() {
      mobileMenu.classList.toggle('active');
      this.classList.toggle('active');
    });
  }

  // Search popup functionality
  const searchToggle = document.querySelector('.search-toggle-luxe');
  const searchPopup = document.getElementById('searchPopup');
  const searchClose = document.querySelector('.search-close-luxe');
  const searchInput = document.getElementById('searchInput');
  const recentlyViewedGrid = document.getElementById('recentlyViewedGrid');
  const allProductsGrid = document.getElementById('allProductsGrid');

  // Debug: Check if elements exist
  console.log('Search elements found:', {
    searchToggle: !!searchToggle,
    searchPopup: !!searchPopup,
    searchClose: !!searchClose,
    searchInput: !!searchInput,
    recentlyViewedGrid: !!recentlyViewedGrid,
    allProductsGrid: !!allProductsGrid
  });

  // Recently viewed products functionality
  class RecentlyViewed {
    static STORAGE_KEY = 'recentlyViewed';
    static MAX_PRODUCTS = 4;
    
    static addProduct(productHandle) {
      let viewedProducts = this.getProducts();
      viewedProducts = viewedProducts.filter(handle => handle !== productHandle);
      viewedProducts.unshift(productHandle);
      viewedProducts = viewedProducts.slice(0, this.MAX_PRODUCTS);
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(viewedProducts));
    }
    
    static getProducts() {
      return JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '[]');
    }
    
    static clearProducts() {
      localStorage.removeItem(this.STORAGE_KEY);
    }
  }

  // Recent searches functionality
  class RecentSearches {
    static STORAGE_KEY = 'recentSearches';
    static MAX_SEARCHES = 8;
    
    static addSearch(query) {
      if (!query || query.trim().length === 0) return;
      
      let searches = this.getSearches();
      searches = searches.filter(s => s.toLowerCase() !== query.toLowerCase());
      searches.unshift(query.trim());
      searches = searches.slice(0, this.MAX_SEARCHES);
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(searches));
    }
    
    static getSearches() {
      return JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '[]');
    }
    
    static removeSearch(query) {
      let searches = this.getSearches();
      searches = searches.filter(s => s !== query);
      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(searches));
    }
    
    static clearSearches() {
      localStorage.removeItem(this.STORAGE_KEY);
    }
  }

  // Search toggle - Open popup for both desktop and mobile
  if (searchToggle) {
    searchToggle.addEventListener('click', function() {
      console.log('Opening search popup...');
      searchPopup.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput.focus(), 300);
      
      loadRecentSearches();
      loadRecentlyViewed();
      loadAllProducts();
      
      console.log('Search popup opened successfully');
    });
  }

  // Close search popup
  if (searchClose) {
    searchClose.addEventListener('click', closeSearchPopup);
  }

  // Close on overlay click
  if (searchPopup) {
    searchPopup.addEventListener('click', function(e) {
      if (e.target === searchPopup) {
        closeSearchPopup();
      }
    });
  }

  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && searchPopup.classList.contains('active')) {
      closeSearchPopup();
    }
  });

  function closeSearchPopup() {
    searchPopup.classList.remove('active');
    document.body.style.overflow = '';
    searchInput.value = '';
    
    // Reset sections visibility
    document.querySelector('.recent-searches-section').style.display = 'block';
    document.querySelector('.recently-viewed-section').style.display = 'block';
    document.querySelector('.products-section .section-header h3').textContent = 'Products';
    document.querySelector('.search-controls').style.display = 'none';
    
    // Restore original products
    loadAllProducts();
  }

  // Simple search functionality
  let searchTimeout;
  let allProductsCache = []; // Cache ALL products for quick restore
  let isSearching = false; // Flag to track if search is in progress
  
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      const query = this.value.trim();
      
      if (query.length > 0) {
        // Hide other sections when searching
        document.querySelector('.recent-searches-section').style.display = 'none';
        document.querySelector('.recently-viewed-section').style.display = 'none';
        
        // Use "Results" on mobile, "Search Results" on desktop
        const isMobile = window.innerWidth <= 480;
        const headerText = isMobile ? 'Results' : 'Search Results';
        document.querySelector('.products-section .section-header h3').textContent = headerText;
        document.querySelector('.search-controls').style.display = 'flex';
        
        isSearching = true;
        searchTimeout = setTimeout(() => {
          performSearch(query);
          // Save to recent searches after search
          RecentSearches.addSearch(query);
          // Update recent searches list immediately
          loadRecentSearches();
        }, 300);
      } else {
        // Cancel any pending search
        isSearching = false;
        
        // Hide search controls
        document.querySelector('.search-controls').style.display = 'none';
        
        // Show initial sections
        document.querySelector('.recent-searches-section').style.display = 'block';
        document.querySelector('.recently-viewed-section').style.display = 'block';
        document.querySelector('.products-section .section-header h3').textContent = 'Products';
        
        // Reload recent searches to show updated list
        loadRecentSearches();
        
        // Always restore ALL products when clearing search - no delay
        if (allProductsCache.length > 0) {
          // Use cached all products immediately
          const productsHTML = allProductsCache.map(product => window.createProductCard(product)).join('');
          allProductsGrid.innerHTML = productsHTML;
        } else {
          // Show loading and load all products
          allProductsGrid.innerHTML = '<div class="loading-message">Loading products...</div>';
          loadAllProducts();
        }
      }
    });
  }

  function performSearch(query) {
    allProductsGrid.innerHTML = '<div class="loading-message">Searching...</div>';
    
    // Use manual search first for better results
    searchSimple(query);
  }
  
  function searchWithShopifyAPI(query) {
    console.log('Searching with Shopify API for:', query);
    
    // Use Shopify's search endpoint
    fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=50`)
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.resources?.results?.products || [];
        if (products.length > 0) {
          console.log(`Found ${products.length} products via search API`);
          displaySearchResults(products);
        } else {
          // Fallback to manual search
          searchSimple(query);
        }
      })
      .catch(error => {
        console.error('Search API failed:', error);
        // Fallback to manual search
        searchSimple(query);
      });
  }
  
  function searchSimple(query) {
    console.log('Simple search for:', query);
    
    // Try products.json first, then collections
    trySearchInProducts(query)
      .catch(() => trySearchInAllCollection(query))
      .catch(() => trySearchInCollections(query))
      .catch(() => {
        // Only show error if still searching (user hasn't cleared input)
        if (isSearching) {
          console.error('All search methods failed');
          allProductsGrid.innerHTML = `<div class="loading-message">No results found for "${query}".</div>`;
        }
      });
  }
  
  function trySearchInProducts(query) {
    return fetch('/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        if (filteredProducts.length > 0) {
          console.log(`Found ${filteredProducts.length} products in products.json`);
          displaySearchResults(filteredProducts);
          return filteredProducts;
        } else {
          throw new Error('No matching products found');
        }
      });
  }
  
  function trySearchInAllCollection(query) {
    return fetch('/collections/all/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        if (filteredProducts.length > 0) {
          console.log(`Found ${filteredProducts.length} products in all collection`);
          displaySearchResults(filteredProducts);
          return filteredProducts;
        } else {
          throw new Error('No matching products found');
        }
      });
  }
  
  function trySearchInCollections(query) {
    return fetch('/collections.json')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const collections = data.collections || [];
        if (collections.length === 0) throw new Error('No collections found');
        
        return searchInMultipleCollections(collections.slice(0, 5), query, []);
      });
  }
  
  function searchInMultipleCollections(collections, query, allResults) {
    if (collections.length === 0) {
      if (allResults.length > 0) {
        displaySearchResults(allResults);
        return allResults;
      } else {
        throw new Error('No results found');
      }
    }
    
    const collection = collections[0];
    const remainingCollections = collections.slice(1);
    
    return fetch(`/collections/${collection.handle}/products.json?limit=20`)
      .then(response => response.ok ? response.json() : { products: [] })
      .then(data => {
        const products = data.products || [];
        const filteredProducts = filterProductsByQuery(products, query);
        
        console.log(`Found ${filteredProducts.length} products in ${collection.handle}`);
        allResults.push(...filteredProducts);
        
        return searchInMultipleCollections(remainingCollections, query, allResults);
      })
      .catch(error => {
        console.error(`Error searching in ${collection.handle}:`, error);
        return searchInMultipleCollections(remainingCollections, query, allResults);
      });
  }
  
  function filterProductsByQuery(products, query) {
    if (!query || query.trim() === '') return products;
    
    return products.filter(product => {
      const title = (product.title || '').toLowerCase();
      const vendor = (product.vendor || '').toLowerCase();
      const productType = (product.product_type || '').toLowerCase();
      const tags = (product.tags || []).join(' ').toLowerCase();
      const searchQuery = query.toLowerCase().trim();
      
      // Search in title, vendor, product type, and tags
      const searchableText = `${title} ${vendor} ${productType} ${tags}`;
      
      // Direct substring match - most common case
      if (searchableText.includes(searchQuery)) {
        return true;
      }
      
      // Word-by-word match for multi-word queries
      const queryWords = searchQuery.split(/\s+/).filter(word => word.length > 0);
      if (queryWords.length > 1) {
        // All words must be found somewhere in searchable text
        return queryWords.every(queryWord => searchableText.includes(queryWord));
      }
      
      // Partial word match - check if query matches start of any word
      const words = searchableText.split(/\s+/);
      return words.some(word => word.startsWith(searchQuery));
    });
  }

  function displaySearchResults(products) {
    // Only update if still searching (user hasn't cleared input)
    if (!isSearching) {
      return;
    }
    
    // Save products for sort/filter
    currentProducts = products;
    
    if (products.length === 0) {
      // Show "No Results" with suggestions
      showNoResultsSuggestions();
      return;
    }

    // Update section header with result count
    const sectionHeader = document.querySelector('.products-section .section-header h3');
    if (sectionHeader) {
      const query = document.getElementById('searchInput').value.trim();
      if (query) {
        // Use "Results" on mobile, "Search Results" on desktop
        const isMobile = window.innerWidth <= 480;
        const headerText = isMobile ? `Results (${products.length})` : `Search Results (${products.length})`;
        sectionHeader.textContent = headerText;
      } else {
        sectionHeader.textContent = 'Products';
      }
    }

    const productsHTML = products.map(product => window.createProductCard(product)).join('');
    allProductsGrid.innerHTML = productsHTML;
  }

  function showNoResultsSuggestions() {
    const query = document.getElementById('searchInput').value.trim();
    
    // Get popular products (first 8 from cache)
    const popularProducts = allProductsCache.slice(0, 8);
    
    let html = `
      <div class="no-results-container">
        <h4>No results found for "${query}"</h4>
        <p style="color: #999; font-size: 14px;">Try different keywords or browse our popular products below</p>
    `;
    
    if (popularProducts.length > 0) {
      html += `
        <div class="popular-products">
          <h5>Popular Products</h5>
          <div class="products-grid">
            ${popularProducts.map(product => window.createProductCard(product)).join('')}
          </div>
        </div>
      `;
    }
    
    html += '</div>';
    allProductsGrid.innerHTML = html;
  }

  function loadRecentlyViewed() {
    const recentlyViewed = RecentlyViewed.getProducts();
    
    if (recentlyViewed.length === 0) {
      recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
      return;
    }

    // Get product details for recently viewed items
    const productPromises = recentlyViewed.slice(0, 4).map(productHandle => 
      fetch(`/products/${productHandle}.js`).then(r => r.json()).catch(() => null)
    );

    Promise.all(productPromises).then(products => {
      const validProducts = products.filter(p => p !== null);
      const productsHTML = validProducts.map(product => window.createProductCard(product)).join('');
      recentlyViewedGrid.innerHTML = productsHTML || '<div class="loading-message">No recently viewed products.</div>';
    });
  }

  function loadAllProducts() {
    allProductsGrid.innerHTML = '<div class="loading-message">Loading products...</div>';
    
    // Simple approach: just try to get any products that work
    loadProductsSimple();
  }
  
  function loadProductsSimple() {
    console.log('Loading products...');
    
    // Try multiple approaches in sequence
    tryLoadFromAllCollection()
      .catch(() => tryLoadFromCollections())
      .catch(() => tryLoadFromRecentlyViewed())
      .catch(() => showFallbackMessage());
  }
  
  function tryLoadFromAllCollection() {
    // Try different endpoints
    return fetch('/products.json?limit=50')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const products = data.products || [];
        if (products.length === 0) throw new Error('No products found');
        
        console.log(`Loaded ${products.length} products from products.json`);
        allProductsCache = products; // Cache ALL products
        currentProducts = products; // Set currentProducts for sort/filter
        const productsHTML = products.map(product => window.createProductCard(product)).join('');
        allProductsGrid.innerHTML = productsHTML;
        return products;
      })
      .catch(error => {
        console.error('products.json failed, trying collections/all:', error);
        return fetch('/collections/all/products.json?limit=50')
          .then(response => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then(data => {
            const products = data.products || [];
            if (products.length === 0) throw new Error('No products found');
            
            console.log(`Loaded ${products.length} products from all collection`);
            allProductsCache = products; // Cache ALL products
            currentProducts = products; // Set currentProducts for sort/filter
            const productsHTML = products.map(product => window.createProductCard(product)).join('');
            allProductsGrid.innerHTML = productsHTML;
            return products;
          });
      });
  }
  
  function tryLoadFromCollections() {
    return fetch('/collections.json')
      .then(response => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then(data => {
        const collections = data.collections || [];
        if (collections.length === 0) throw new Error('No collections found');
        
        // Find a collection with products
        const validCollections = collections.filter(c => c.products_count > 0);
        const targetCollection = validCollections.length > 0 ? validCollections[0] : collections[0];
        
        return fetch(`/collections/${targetCollection.handle}/products.json?limit=8`)
          .then(response => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then(data => {
            const products = data.products || [];
            if (products.length === 0) throw new Error('No products in collection');
            
            console.log(`Loaded ${products.length} products from ${targetCollection.handle}`);
            allProductsCache = products; // Cache ALL products
            currentProducts = products; // Set currentProducts for sort/filter
            const productsHTML = products.map(product => window.createProductCard(product)).join('');
            allProductsGrid.innerHTML = productsHTML;
            return products;
          });
      });
  }
  
  function tryLoadFromRecentlyViewed() {
    const recentlyViewed = RecentlyViewed.getProducts();
    
    if (recentlyViewed.length === 0) {
      throw new Error('No recently viewed products');
    }
    
    console.log('Loading recently viewed as fallback');
    
    const productPromises = recentlyViewed.slice(0, 8).map(productHandle => 
      fetch(`/products/${productHandle}.js`)
        .then(r => r.ok ? r.json() : null)
        .catch(() => null)
    );

    return Promise.all(productPromises).then(products => {
      const validProducts = products.filter(p => p !== null);
      
      if (validProducts.length === 0) {
        throw new Error('No valid recently viewed products');
      }
      
      console.log(`Showing ${validProducts.length} recently viewed products`);
      allProductsCache = validProducts; // Cache ALL products
      currentProducts = validProducts; // Set currentProducts for sort/filter
      const productsHTML = validProducts.map(product => window.createProductCard(product)).join('');
      allProductsGrid.innerHTML = productsHTML;
      return validProducts;
    });
  }
  
  function showFallbackMessage() {
    console.log('All product loading methods failed, showing fallback');
    allProductsGrid.innerHTML = `
      <div class="loading-message">
        <p>Browse our products</p>
        <a href="/collections/all" style="color: #000; text-decoration: underline; font-weight: 600;">View All Products â†’</a>
      </div>
    `;
  }

  // Use createProductCard from search-popup.js file
  // Old function removed due to encoding issues

  // Global functions
  window.goToProduct = function(handle) {
    if (handle && handle !== '#') {
      RecentlyViewed.addProduct(handle);
      window.location.href = `/products/${handle}`;
    }
  };

  window.clearRecentlyViewed = function() {
    RecentlyViewed.clearProducts();
    recentlyViewedGrid.innerHTML = '<div class="loading-message">No recently viewed products.</div>';
  };

  window.clearRecentSearches = function() {
    RecentSearches.clearSearches();
    document.getElementById('recentSearchesList').innerHTML = '<div class="loading-message">No recent searches.</div>';
  };

  // Load recent searches
  function loadRecentSearches() {
    const recentSearches = RecentSearches.getSearches();
    const recentSearchesList = document.getElementById('recentSearchesList');
    
    if (recentSearches.length === 0) {
      recentSearchesList.innerHTML = '<div class="loading-message">No recent searches.</div>';
      return;
    }

    const searchesHTML = recentSearches.map(search => `
      <div class="recent-search-item" onclick="searchFromRecent('${search.replace(/'/g, "\\'")}')">
        <span>${search}</span>
        <span class="remove-icon" onclick="event.stopPropagation(); removeRecentSearch('${search.replace(/'/g, "\\'")}')">×</span>
      </div>
    `).join('');
    
    recentSearchesList.innerHTML = searchesHTML;
  }

  window.searchFromRecent = function(query) {
    searchInput.value = query;
    searchInput.dispatchEvent(new Event('input'));
  };

  window.removeRecentSearch = function(query) {
    RecentSearches.removeSearch(query);
    loadRecentSearches();
  };

  // Sort and filter functionality
  let currentSortValue = 'relevance';
  let currentFilterValue = 'all';
  let currentProducts = [];

  // Desktop: Native select elements
  const sortSelect = document.getElementById('sortSelect');
  const filterSelect = document.getElementById('filterSelect');

  // Mobile: Custom dropdown elements
  const sortButton = document.getElementById('sortButton');
  const sortDropdown = document.getElementById('sortDropdown');
  const filterButton = document.getElementById('filterButton');
  const filterDropdown = document.getElementById('filterDropdown');

  console.log('Sort/Filter elements:', { 
    sortSelect: !!sortSelect,
    filterSelect: !!filterSelect,
    sortButton: !!sortButton, 
    sortDropdown: !!sortDropdown,
    filterButton: !!filterButton,
    filterDropdown: !!filterDropdown
  });

  // Desktop: Native select event listeners
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      currentSortValue = this.value;
      console.log('Sort changed to:', currentSortValue, 'Products count:', currentProducts.length);
      if (currentProducts.length > 0) {
        applySortAndFilter();
      }
    });
  }

  if (filterSelect) {
    filterSelect.addEventListener('change', function() {
      currentFilterValue = this.value;
      console.log('Filter changed to:', currentFilterValue, 'Products count:', currentProducts.length);
      if (currentProducts.length > 0) {
        applySortAndFilter();
      }
    });
  }

  // Mobile: Custom dropdown event listeners
  if (sortButton && sortDropdown) {
    sortButton.addEventListener('click', function(e) {
      e.stopPropagation();
      const isActive = sortDropdown.classList.contains('active');
      
      // Close all dropdowns
      document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      document.querySelectorAll('.custom-select-button').forEach(b => b.classList.remove('active'));
      
      // Toggle this dropdown
      if (!isActive) {
        sortDropdown.classList.add('active');
        sortButton.classList.add('active');
      }
    });

    sortDropdown.querySelectorAll('.custom-select-option').forEach(option => {
      option.addEventListener('click', function() {
        const value = this.dataset.value;
        const text = this.textContent;
        
        currentSortValue = value;
        sortButton.querySelector('.custom-select-value').textContent = text;
        
        // Update selected state
        sortDropdown.querySelectorAll('.custom-select-option').forEach(opt => opt.classList.remove('selected'));
        this.classList.add('selected');
        
        // Close dropdown
        sortDropdown.classList.remove('active');
        sortButton.classList.remove('active');
        
        console.log('Sort changed to:', value, 'Products count:', currentProducts.length);
        
        // Apply sort and filter
        if (currentProducts.length > 0) {
          applySortAndFilter();
        }
      });
    });
  }

  if (filterButton && filterDropdown) {
    filterButton.addEventListener('click', function(e) {
      e.stopPropagation();
      const isActive = filterDropdown.classList.contains('active');
      
      // Close all dropdowns
      document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
      document.querySelectorAll('.custom-select-button').forEach(b => b.classList.remove('active'));
      
      // Toggle this dropdown
      if (!isActive) {
        filterDropdown.classList.add('active');
        filterButton.classList.add('active');
      }
    });

    filterDropdown.querySelectorAll('.custom-select-option').forEach(option => {
      option.addEventListener('click', function() {
        const value = this.dataset.value;
        const text = this.textContent;
        
        currentFilterValue = value;
        filterButton.querySelector('.custom-select-value').textContent = text;
        
        // Update selected state
        filterDropdown.querySelectorAll('.custom-select-option').forEach(opt => opt.classList.remove('selected'));
        this.classList.add('selected');
        
        // Close dropdown
        filterDropdown.classList.remove('active');
        filterButton.classList.remove('active');
        
        console.log('Filter changed to:', value, 'Products count:', currentProducts.length);
        
        // Apply sort and filter
        if (currentProducts.length > 0) {
          applySortAndFilter();
        }
      });
    });
  }

  // Close dropdowns when clicking outside
  document.addEventListener('click', function() {
    document.querySelectorAll('.custom-select-dropdown').forEach(d => d.classList.remove('active'));
    document.querySelectorAll('.custom-select-button').forEach(b => b.classList.remove('active'));
  });

  function applySortAndFilter() {
    console.log('Applying sort and filter to', currentProducts.length, 'products');
    console.log('allProductsGrid element:', allProductsGrid);
    let products = [...currentProducts];
    
    // Apply filter
    console.log('Filtering by:', currentFilterValue);
    if (currentFilterValue === 'sale') {
      products = products.filter(p => {
        const comparePrice = p.compare_at_price || p.compare_at_price_max;
        const price = p.price || p.price_min;
        return comparePrice && comparePrice > price;
      });
    } else if (currentFilterValue === 'instock') {
      products = products.filter(p => p.available !== false);
    }

    // Helper function to parse price to number for comparison
    function parsePrice(product) {
      // Try to get raw price value (before formatting)
      let price = product.price || product.price_min || 0;
      
      // If we have variants, try to get price from first variant
      if ((!price || price === 0) && product.variants && product.variants.length > 0) {
        price = product.variants[0].price || 0;
      }
      
      // Handle string prices (already formatted like "$29.99")
      if (typeof price === 'string') {
        // Remove $ and , then parse
        const cleanPrice = price.replace(/[$,]/g, '').trim();
        const numPrice = parseFloat(cleanPrice);
        
        if (isNaN(numPrice)) return 0;
        
        // If string had decimal point, it's in dollars, convert to cents for comparison
        if (cleanPrice.includes('.')) {
          return Math.round(numPrice * 100);
        }
        
        // Otherwise treat as cents
        return Math.round(numPrice);
      }
      
      // Handle number prices (should be in cents from Shopify API)
      if (typeof price === 'number') {
        return Math.round(price);
      }
      
      return 0;
    }

    // Apply sort
    console.log('Sorting by:', currentSortValue);
    if (currentSortValue === 'price-asc') {
      products.sort((a, b) => {
        const priceA = parsePrice(a);
        const priceB = parsePrice(b);
        console.log('Comparing:', a.title, priceA, 'vs', b.title, priceB);
        return priceA - priceB;
      });
    } else if (currentSortValue === 'price-desc') {
      products.sort((a, b) => {
        const priceA = parsePrice(a);
        const priceB = parsePrice(b);
        return priceB - priceA;
      });
    } else if (currentSortValue === 'title-asc') {
      products.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
    } else if (currentSortValue === 'title-desc') {
      products.sort((a, b) => (b.title || '').localeCompare(a.title || ''));
    }

    console.log('After filter and sort:', products.length, 'products');
    console.log('First 3 products:', products.slice(0, 3).map(p => ({ title: p.title, price: parsePrice(p) })));
    console.log('window.createProductCard exists:', typeof window.createProductCard);

    // Display filtered and sorted products
    if (products.length === 0) {
      allProductsGrid.innerHTML = '<div class="loading-message">No products match your filters.</div>';
    } else {
      try {
        const productsHTML = products.map(product => window.createProductCard(product)).join('');
        console.log('Generated HTML length:', productsHTML.length);
        console.log('Setting innerHTML...');
        allProductsGrid.innerHTML = productsHTML;
        console.log('Products displayed successfully');
        console.log('Grid children count:', allProductsGrid.children.length);
      } catch (error) {
        console.error('Error creating product cards:', error);
        allProductsGrid.innerHTML = '<div class="loading-message">Error displaying products.</div>';
      }
    }
  }

  // Make applySortAndFilter available globally for debugging
  window.applySortAndFilter = applySortAndFilter;
  window.getCurrentProducts = () => currentProducts;
});
</script>

