        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      OVER 10,000+ HAPPY CUSTOMERS
    </span>
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      FREE SHIPPING OVER $50
    </span>
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      OVER 10,000+ HAPPY CUSTOMERS
    </span>
    <!-- Duplicate for seamless loop -->
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      FREE SHIPPING OVER $50
    </span>
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      OVER 10,000+ HAPPY CUSTOMERS
    </span>
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      FREE SHIPPING OVER $50
    </span>
    <span class="scroll-item-bar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      OVER 10,000+ HAPPY CUSTOMERS
    </span>
  </div>
</div>

<style>
/* Scrolling Announcement Bar */
.product-scrolling-bar {
  background: #1e3a8a;
  color: #ffffff;
  padding: 12px 0;
  overflow: hidden;
  position: relative;
  margin: 60px 0;
}

.scrolling-content-bar {
  display: flex;
  animation: scroll-bar 30s linear infinite;
  white-space: nowrap;
}

.scroll-item-bar {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0 50px;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.scroll-item-bar svg {
  flex-shrink: 0;
}

@keyframes scroll-bar {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media (max-width: 768px) {
  .product-scrolling-bar {
    margin: 40px 0;
    padding: 10px 0;
  }
  
  .scroll-item-bar {
    padding: 0 30px;
    font-size: 12px;
  }
}

/* Product Page Layout */
.product-page {
  padding: 40px 0;
  background: #f8f8f8;
}

.product-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  background: #ffffff;
  padding: 40px;
  border-radius: 8px;
}

/* Product Gallery */
.product-gallery {
  position: sticky;
  top: 100px;
  height: fit-content;
}

.main-image {
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 15px;
  background: #ffffff;
}

.main-image img {
  width: 100%;
  height: auto;
  display: block;
}

.thumbnail-gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.thumbnail {
  border: 2px solid #e0e0e0;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
}

.thumbnail:hover,
.thumbnail.active {
  border-color: #ff8200;
}

.thumbnail img {
  width: 100%;
  height: auto;
  display: block;
}

/* Product Info */
.product-info {
  max-width: 600px;
}

.product-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 15px;
  line-height: 1.3;
  color: #000000;
}

.product-reviews {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 20px;
}

.stars {
  color: #ffa500;
  font-size: 20px;
  line-height: 1;
  letter-spacing: 2px;
}

.review-count {
  color: #666666;
  font-size: 18px;
  line-height: 1;
}

/* Price */
.product-price {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.current-price {
  font-size: 36px;
  font-weight: 700;
  color: #000000;
}

.original-price {
  font-size: 24px;
  color: #999999;
  text-decoration: line-through;
}

.discount-badge {
  background: #000000;
  color: #ffffff;
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 600;
}

/* Features */
.product-features {
  margin-bottom: 25px;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  color: #333333;
  font-size: 15px;
}

.feature-item .checkmark {
  width: 20px;
  height: 20px;
  background: #000000;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  flex-shrink: 0;
}

/* Urgency Alert */
.urgency-alert {
  background: #fff9e6;
  border: 1px solid #ffd700;
  border-radius: 8px;
  padding: 15px;
  display: flex;
  gap: 15px;
  margin-bottom: 25px;
}

.urgency-alert .alert-icon {
  width: 24px;
  height: 24px;
  background: #ff0000;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: bold;
  flex-shrink: 0;
  margin-top: 2px;
}

.urgency-alert strong {
  display: block;
  margin-bottom: 5px;
  color: #000000;
  font-size: 15px;
}

.urgency-alert p {
  margin: 0;
  color: #666666;
  font-size: 13px;
}

/* Bundle Section */
.bundle-section {
  margin-bottom: 30px;
}

.bundle-title {
  text-align: center;
  font-size: 16px;
  font-weight: 700;
  color: #000000;
  margin-bottom: 25px;
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.bundle-title::before,
.bundle-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #000000;
}

.bundle-title::before {
  margin-right: 15px;
}

.bundle-title::after {
  margin-left: 15px;
}

.bundle-options {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.bundle-option {
  position: relative;
  display: block;
  cursor: pointer;
}

.bundle-option input[type="radio"] {
  position: absolute;
  opacity: 0;
}

.bundle-content {
  border: 3px solid #e0e0e0;
  border-radius: 12px;
  padding: 18px 20px;
  background: #ffedc4;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 15px;
  position: relative;
}

.bundle-option input[type="radio"]:checked + .bundle-content {
  border-color: rgb(255, 173, 8);
  background: rgb(255, 173, 8);
}

.bundle-option input[type="radio"]:checked + .bundle-content .radio-circle {
  border-color: #000000;
  background: #ffffff;
}

.bundle-option input[type="radio"]:checked + .bundle-content .radio-circle::after {
  opacity: 1;
}

.radio-circle {
  width: 28px;
  height: 28px;
  border: 3px solid #cccccc;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
  position: relative;
  transition: all 0.3s ease;
}

.bundle-option input[type="radio"]:checked + .bundle-content .radio-circle {
  border-color: #000000;
  background: #ffffff;
}

.bundle-option input[type="radio"]:checked + .bundle-content .radio-circle::after {
  opacity: 1;
}

.radio-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #000000;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.bundle-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.bundle-left {
  flex: 1;
}

.bundle-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 5px;
  flex-wrap: wrap;
}

.bundle-name {
  font-weight: 700;
  color: #000000;
  font-size: 18px;
}

.bundle-badge {
  background: #e3f2fd;
  color: #1976d2;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.popular-badge {
  position: absolute;
  top: -12px;
  right: 20px;
  background: #000000;
  color: #ffffff;
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
}

.bundle-subtitle {
  color: #666666;
  font-size: 14px;
  margin-top: 2px;
}

.bundle-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.bundle-price .price {
  font-size: 28px;
  font-weight: 700;
  color: #000000;
  line-height: 1;
}

.bundle-price .original {
  font-size: 16px;
  color: #999999;
  text-decoration: line-through;
}

/* Add to Cart Button - Complete Override */
.add-to-cart-btn {
  width: 100%;
  background: #ff8c00 !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 50px;
  padding: 18px 40px;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-bottom: 25px;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 2px 8px rgba(255, 140, 0, 0.3);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56px;
}

.add-to-cart-btn:hover:not(:disabled) {
  background: #ff7700 !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(255, 140, 0, 0.4);
}

.add-to-cart-btn:disabled {
  background: #cccccc !important;
  cursor: not-allowed;
  transform: none;
}

/* Override ALL Shopify loading states */
.add-to-cart-btn.btn--loading,
.add-to-cart-btn.loading,
.add-to-cart-btn[aria-describedby*="loading"],
button.btn--loading,
button.loading {
  background: #ff8c00 !important;
  color: #ffffff !important;
}

.add-to-cart-btn.btn--loading .btn__text,
.add-to-cart-btn.loading .btn__text,
.btn--loading .btn__text,
.loading .btn__text {
  display: none !important;
}

.add-to-cart-btn.btn--loading .loading__spinner,
.add-to-cart-btn.loading .loading__spinner,
.btn--loading .loading__spinner,
.loading .loading__spinner,
.loading-overlay {
  display: none !important;
}

/* Custom Button States */
.add-to-cart-btn .btn-text {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
}

.add-to-cart-btn .btn-spinner {
  display: none;
  align-items: center;
  justify-content: center;
}

.add-to-cart-btn .btn-success {
  display: none;
  align-items: center;
  justify-content: center;
}

/* Custom Loading State */
.add-to-cart-btn.loading {
  background: #ff8c00 !important;
}

.add-to-cart-btn.loading .btn-text {
  display: none !important;
}

.add-to-cart-btn.loading .btn-spinner {
  display: flex !important;
}

.add-to-cart-btn.loading .btn-success {
  display: none !important;
}

/* Custom Success State */
.add-to-cart-btn.success {
  background: #4caf50 !important;
}

.add-to-cart-btn.success .btn-text {
  display: none !important;
}

.add-to-cart-btn.success .btn-spinner {
  display: none !important;
}

.add-to-cart-btn.success .btn-success {
  display: flex !important;
}

/* Custom Spinner Animation */
.btn-spinner svg {
  animation: customSpin 1s linear infinite;
  width: 24px;
  height: 24px;
}

@keyframes customSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Hide ALL Shopify notifications and loading elements */
.shopify-section-group-header-group .cart-notification,
.notification-bar .cart-notification,
[data-cart-notification].notification,
.cart-added-notification.notification,
.loading-overlay,
.btn-loading-spinner,
.loading__spinner,
.spinner,
.btn__spinner,
[class*="loading-"],
[class*="spinner-"] {
