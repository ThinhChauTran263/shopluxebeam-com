{% comment %}
  Main product section - Professional e-commerce layout (OPTIMIZED)
{% endcomment %}

<div class="product-page">
  <div class="container">
    <div class="product-layout">
      <!-- Product Images -->
      <div class="product-gallery">
        <div class="main-image">
          {% if product.featured_media %}
            <img src="{{ product.featured_media | image_url: width: 600 }}" 
                 alt="{{ product.featured_media.alt | escape }}"
                 id="main-product-image"
                 class="img-fluid"
                 width="600"
                 height="600">
          {% else %}
            <img src="https://via.placeholder.com/600x600/f0f0f0/666666?text=Product+Image" 
                 alt="{{ product.title }}"
                 width="600"
                 height="600">
          {% endif %}
        </div>
        
        {% if product.media.size > 1 %}
          <div class="thumbnail-gallery">
            {% for media in product.media limit: 4 %}
              <div class="thumbnail {% if forloop.first %}active{% endif %}" data-image="{{ media | image_url: width: 600 }}">
                <img src="{{ media | image_url: width: 100 }}" 
                     alt="{{ media.alt | escape }}"
                     width="100"
                     height="100">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <!-- Title & Reviews -->
        <h1 class="product-title">{{ product.title }}</h1>
        
        {% if section.settings.show_reviews %}
          {% render 'product-reviews-stars', rating: section.settings.review_stars, review_count: section.settings.review_count %}
        {% endif %}

        <!-- Price -->
        <div class="product-price">
          <span class="current-price">{{ product.price | money_without_trailing_zeros }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="original-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
            <span class="discount-badge">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
          {% endif %}
        </div>

        <!-- Features -->
        {% render 'product-features-list', section: section %}

        <!-- Urgency Alert -->
        {% if section.settings.show_urgency_alert %}
          {% render 'urgency-alert', title: section.settings.urgency_title, text: section.settings.urgency_text %}
        {% endif %}

        <!-- Bundle Options -->
        {% render 'product-bundle-selector', section: section %}

        <!-- Add to Cart -->
        <form action="{{ routes.cart_add_url }}" method="post" class="product-form" data-ajax-cart="false" novalidate>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <button type="button" class="add-to-cart-btn custom-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-inventory="{{ product.selected_or_first_available_variant.inventory_quantity }}" {% unless product.available %}disabled{% endunless %}>
            <span class="btn-text">ADD TO CART</span>
            <span class="btn-spinner" style="display: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" stroke-dasharray="31.416" stroke-dashoffset="31.416">
                  <animate attributeName="stroke-dasharray" dur="2s" values="0 31.416;15.708 15.708;0 31.416" repeatCount="indefinite"/>
                  <animate attributeName="stroke-dashoffset" dur="2s" values="0;-15.708;-31.416" repeatCount="indefinite"/>
                </svg>
              </span>
            <span class="btn-success" style="display: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </button>
        </form>

        <!-- Trust Badge -->
        {% if section.settings.show_trust_badge %}
          {% render 'trust-badge', title: section.settings.trust_badge_title, text: section.settings.trust_badge_text %}
        {% endif %}

        <!-- Collapsible Sections -->
        {% render 'product-accordion', section: section %}

        <!-- Payment Icons -->
        {% render 'payment-icons', section: section %}
      </div>
    </div>
  </div>
</div>

<!-- Scrolling Announcement Bar -->
{% render 'scrolling-announcement', section: section %}

{{ 'main-product.css' | asset_url | stylesheet_tag }}
{{ 'main-product.js' | asset_url | script_tag }}

<style>
  /* Product page button colors */
  .cart-checkout-btn,
  button[name="checkout"] {
    background: {{ section.settings.checkout_btn_bg | default: '#b8865f' }} !important;
  }
  
  .cart-checkout-btn:hover,
  button[name="checkout"]:hover {
    background: {{ section.settings.checkout_btn_bg_hover | default: '#a67550' }} !important;
  }
  
  .add-to-cart-btn,
  .custom-add-to-cart {
    background: {{ section.settings.add_to_cart_btn_bg | default: '#000000' }} !important;
  }
  
  .add-to-cart-btn:hover,
  .custom-add-to-cart:hover {
    background: {{ section.settings.add_to_cart_btn_hover | default: '#333333' }} !important;
  }
</style>

