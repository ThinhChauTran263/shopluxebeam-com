{% comment %}
  Main product section - Professional e-commerce layout
{% endcomment %}

<div class="product-page">
  <div class="container">
    <div class="product-layout">
      <!-- Product Images -->
      <div class="product-gallery">
        <div class="main-image">
          {% if product.featured_media %}
            <img src="{{ product.featured_media | image_url: width: 600 }}" 
                 alt="{{ product.featured_media.alt | escape }}"
                 id="main-product-image"
                 class="img-fluid"
                 width="600"
                 height="600">
          {% else %}
            <img src="https://via.placeholder.com/600x600/f0f0f0/666666?text=Product+Image" 
                 alt="{{ product.title }}"
                 width="600"
                 height="600">
          {% endif %}
        </div>
        
        {% if product.media.size > 1 %}
          <div class="thumbnail-gallery">
            {% for media in product.media limit: 4 %}
              <div class="thumbnail {% if forloop.first %}active{% endif %}" data-image="{{ media | image_url: width: 600 }}">
                <img src="{{ media | image_url: width: 100 }}" 
                     alt="{{ media.alt | escape }}"
                     width="100"
                     height="100">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <!-- Title & Reviews -->
        <h1 class="product-title">{{ product.title }}</h1>
        
        <div class="product-reviews">
          <span class="stars">★★★★★</span>
          <span class="review-count">98 reviews</span>
        </div>

        <!-- Price -->
        <div class="product-price">
          <span class="current-price">{{ product.price | money_without_trailing_zeros }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="original-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
            <span class="discount-badge">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
          {% endif %}
        </div>

        <!-- Features -->
        <div class="product-features">
          <div class="feature-item">
            <span class="checkmark">✓</span>
            <span>Strong Powerful Motor</span>
          </div>
          <div class="feature-item">
            <span class="checkmark">✓</span>
            <span>Long Adjustable Handle</span>
          </div>
          <div class="feature-item">
            <span class="checkmark">✓</span>
            <span>8 Different Brush Heads</span>
          </div>
        </div>

        <!-- Urgency Alert -->
        <div class="urgency-alert">
          <span class="alert-icon">⚠</span>
          <div>
            <strong>Update: This product is SELLING OUT faster than expected!</strong>
            <p>Secure yours today while stock lasts.</p>
          </div>
        </div>

        <!-- Bundle Options -->
        <div class="bundle-section">
          <h3 class="bundle-title">SAVE MORE WITH BUNDLES</h3>
          
          <div class="bundle-options">
            <!-- Single -->
            <label class="bundle-option">
              <input type="radio" name="bundle" value="single" checked>
              <div class="bundle-content">
                <div class="radio-circle"></div>
                <div class="bundle-info">
                  <div class="bundle-left">
                    <div class="bundle-header">
                      <span class="bundle-name">Single</span>
                      <span class="bundle-badge">Free Shipping</span>
                    </div>
                    <div class="bundle-subtitle">Standard Sale</div>
                  </div>
                  <div class="bundle-price">
                    <span class="price">$59.99</span>
                    <span class="original">$179.99</span>
                  </div>
                </div>
              </div>
            </label>

            <!-- Buy 2 -->
            <label class="bundle-option popular">
              <input type="radio" name="bundle" value="buy2">
              <div class="bundle-content">
                <div class="radio-circle"></div>
                <div class="bundle-info">
                  <div class="bundle-left">
                    <div class="bundle-header">
                      <span class="bundle-name">Buy 2 Get 10% Off</span>
                      <span class="bundle-badge">FREE SHIPPING</span>
                    </div>
                    <div class="bundle-subtitle">Most Commonly Purchased</div>
                  </div>
                  <div class="bundle-price">
                    <span class="price">$108.00</span>
                    <span class="original">$359.98</span>
                  </div>
                </div>
                <span class="popular-badge">Most Popular</span>
              </div>
            </label>

            <!-- Buy 3 -->
            <label class="bundle-option">
              <input type="radio" name="bundle" value="buy3">
              <div class="bundle-content">
                <div class="radio-circle"></div>
                <div class="bundle-info">
                  <div class="bundle-left">
                    <div class="bundle-header">
                      <span class="bundle-name">Buy 3 Get 15% Off</span>
                      <span class="bundle-badge">FREE SHIPPING</span>
                    </div>
                    <div class="bundle-subtitle">Best value</div>
                  </div>
                  <div class="bundle-price">
                    <span class="price">$153.00</span>
                    <span class="original">$539.97</span>
                  </div>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- Add to Cart -->
        <form action="{{ routes.cart_add_url }}" method="post" class="product-form" data-ajax-cart="false" novalidate>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <button type="button" class="add-to-cart-btn custom-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>
            <span class="btn-text">ADD TO CART</span>
            <span class="btn-spinner" style="display: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" stroke-dasharray="31.416" stroke-dashoffset="31.416">
                  <animate attributeName="stroke-dasharray" dur="2s" values="0 31.416;15.708 15.708;0 31.416" repeatCount="indefinite"/>
                  <animate attributeName="stroke-dashoffset" dur="2s" values="0;-15.708;-31.416" repeatCount="indefinite"/>
                </svg>
              </span>
            <span class="btn-success" style="display: none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </button>
        </form>

        <!-- Trust Badge -->
        <div class="trust-badge">
          <div class="shield-icon">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <strong>30 Days Risk-Free Trial</strong>
            <p>Not what you expected? We'll give your money back!</p>
          </div>
        </div>

        <!-- Collapsible Sections -->
        <div class="product-accordion">
          <details class="accordion-item">
            <summary>What's Included</summary>
            <div class="accordion-content">
              {{ product.description }}
            </div>
          </details>

          <details class="accordion-item">
            <summary>Shipping & Delivery Time</summary>
            <div class="accordion-content">
              <p>Free shipping on all orders. Delivery within 5-7 business days.</p>
            </div>
          </details>

          <details class="accordion-item">
            <summary>30 Days Risk Free</summary>
            <div class="accordion-content">
              <p>Try it risk-free for 30 days. If you're not satisfied, return it for a full refund.</p>
            </div>
          </details>
        </div>

        <!-- Payment Icons -->
        {% if section.settings.show_payment_icons %}
          <div class="payment-icons">
            {% if section.settings.payment_text != blank %}
              <p class="payment-text">{{ section.settings.payment_text }}</p>
            {% endif %}
            {% if section.settings.payment_icon_1 %}
              <img src="{{ section.settings.payment_icon_1 | image_url: width: 60 }}" alt="Payment method" width="60" height="auto">
            {% endif %}
            {% if section.settings.payment_icon_2 %}
              <img src="{{ section.settings.payment_icon_2 | image_url: width: 60 }}" alt="Payment method" width="60" height="auto">
            {% endif %}
            {% if section.settings.payment_icon_3 %}
              <img src="{{ section.settings.payment_icon_3 | image_url: width: 60 }}" alt="Payment method" width="60" height="auto">
            {% endif %}
            {% if section.settings.payment_icon_4 %}
              <img src="{{ section.settings.payment_icon_4 | image_url: width: 60 }}" alt="Payment method" width="60" height="auto">
            {% endif %}
            {% if section.settings.payment_icon_5 %}
              <img src="{{ section.settings.payment_icon_5 | image_url: width: 60 }}" alt="Payment method" width="60" height="auto">
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<!-- Scrolling Announcement Bar -->
