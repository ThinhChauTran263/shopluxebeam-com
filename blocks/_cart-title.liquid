

{% doc %}
  Cart Title

  Renders the cart title or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state

  @example
  {% render 'cart-title', force_empty: true %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
%}

<div
  class="cart-title spacing-style text-{{ block_settings.alignment }}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <h1 class="{{ block_settings.type_preset | default: 'h2' }}">
    {%- if cart.empty? or force_empty -%}
      Your cart is empty
    {%- else -%}
      {{ block_settings.title }}
      {%- if block_settings.show_count -%}
        <span class="cart-bubble cart-bubble__background">
          <span class="cart-bubble__text">{{ cart.item_count }}</span>
        </span>
      {%- endif -%}
    {%- endif -%}
  </h1>
</div>

{% stylesheet %}
  .cart-title h1 {
    margin-block-end: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .cart-title .cart-bubble {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    aspect-ratio: auto;
    padding: 4px 8px;
    min-width: 26px;
    height: 26px;
  }

  .cart-title .cart-bubble__background {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .cart-title .cart-bubble__text {
    color: #000;
    font-size: 14px;
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart Title",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Cart Title",
      "default": "Cart"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show item count",
      "default": true
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Typography preset",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
