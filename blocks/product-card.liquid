{%- liquid
  assign product = all_products[block.settings.product]
  assign show_vendor = block.settings.show_vendor | default: false
  assign show_rating = block.settings.show_rating | default: false
-%}

{%- if product != blank -%}
  <div class="product-card-block luxebeam-product-card" {{ block.shopify_attributes }}>
    <div class="product-card__media">
      <a href="{{ product.url }}" class="product-card__link">
        {%- if product.featured_media -%}
          <img
            src="{{ product.featured_media | image_url: width: 400 }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="400"
            height="400"
            class="product-card__image"
            loading="lazy"
          >
        {%- else -%}
          <div class="product-card__placeholder">
            <span>{{ 'products.product.media.image_not_available' | t }}</span>
          </div>
        {%- endif -%}
      </a>
      
      {%- if product.compare_at_price > product.price -%}
        <div class="product-card__badge sale-badge">
          {{ 'products.product.on_sale' | t }}
        </div>
      {%- endif -%}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
      
      <div class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="price price--on-sale">
            {{ product.price | money }}
          </span>
          <span class="price price--compare">
            {{ product.compare_at_price | money }}
          </span>
        {%- else -%}
          <span class="price">
            {{ product.price | money }}
          </span>
        {%- endif -%}
      </div>

      {%- if show_vendor and product.vendor != blank -%}
        <div class="product-card__vendor">
          {{ product.vendor }}
        </div>
      {%- endif -%}

      {%- if block.settings.show_quick_add -%}
        <div class="product-card__actions">
          <button class="button luxebeam-button button-secondary quick-add-button" 
                  data-product-id="{{ product.id }}">
            {{ 'products.product.add_to_cart' | t }}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  <div class="product-card-block product-card--placeholder" {{ block.shopify_attributes }}>
    <div class="product-card__media">
      <div class="product-card__placeholder">
        <span>{{ 'onboarding.product_title' | t }}</span>
      </div>
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="product-card__price">
        <span class="price">$19.99</span>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  .product-card-block {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .product-card-block:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }
  
  .product-card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  
  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .product-card__link:hover .product-card__image {
    transform: scale(1.05);
  }
  
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    font-size: 0.875rem;
  }
  
  .product-card__badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--luxebeam-primary);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: bold;
  }
  
  .product-card__info {
    padding: 1rem;
  }
  
  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .product-card__title a {
    text-decoration: none;
    color: var(--color-foreground-heading);
  }
  
  .product-card__title a:hover {
    color: var(--luxebeam-primary);
  }
  
  .product-card__price {
    margin-bottom: 0.5rem;
  }
  
  .price {
    font-weight: 600;
    color: var(--color-foreground);
  }
  
  .price--on-sale {
    color: var(--luxebeam-primary);
  }
  
  .price--compare {
    text-decoration: line-through;
    color: var(--color-foreground);
    opacity: 0.7;
    margin-left: 0.5rem;
  }
  
  .product-card__vendor {
    font-size: 0.875rem;
    color: var(--color-foreground);
    opacity: 0.8;
    margin-bottom: 1rem;
  }
  
  .product-card__actions {
    margin-top: 1rem;
  }
  
  .quick-add-button {
    width: 100%;
    padding: 0.75rem;
    font-size: 0.875rem;
  }
</style>

{% schema %}
{
  "name": "Product card",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    }
  ]
}
{% endschema %}