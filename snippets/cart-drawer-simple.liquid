{% comment %}
  Cart drawer - Full featured - v1.3
{% endcomment %}

<div class="cart-drawer-overlay"></div>

<div class="cart-drawer">
  <div class="cart-drawer-header">
    <button class="cart-drawer-close" aria-label="Close cart" style="position: absolute !important; left: 15px !important; top: 15px !important; transform: translateX(0) !important;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <h2 class="cart-drawer-title" style="padding-left: 0 !important; margin-left: 0 !important; text-indent: 0 !important; padding-top: 45px !important;">
      <span>There are </span>
      <span class="cart-count">0</span>
      <span> products</span>
    </h2>
  </div>
  
  <div class="cart-drawer-items">
    <div class="cart-drawer-loading" style="text-align: center; padding: 40px 20px; color: #666;">
      Loading cart...
    </div>
  </div>
  
  <div class="cart-drawer-footer" style="display: none;">
    <div class="cart-subtotal">
      <span class="cart-subtotal-label">Sub Total:</span>
      <span class="cart-subtotal-price">$0.00</span>
    </div>
    <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
      <button type="submit" name="checkout" class="cart-checkout-btn">CHECKOUT</button>
    </form>
  </div>
</div>

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
