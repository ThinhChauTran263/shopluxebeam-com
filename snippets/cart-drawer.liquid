  margin: 8px 0 0 0 !important;
  padding: 0 !important;
  width: 100% !important;
  position: relative !important;
  z-index: 1 !important;
  background: transparent !important;
}
@media (max-width: 576px) {
  .cart-drawer {
    width: 100%;
    right: -100%;
  }
  
  .cart-drawer-item {
    padding: 12px 0;
    gap: 12px;
  }
  
  .cart-item-image {
    width: 70px;
    height: 70px;
  }
  
  .cart-item-title {
    font-size: 12px;
    line-height: 1.2;
  }
  
  .cart-item-price-qty {
    font-size: 13px;
    gap: 6px;
  }
  
  .cart-item-controls {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  
  .quantity-selector {
    align-self: flex-start;
  }
  
  .cart-item-remove {
    position: absolute;
    top: 12px;
    right: 0;
    margin-left: 0;
  }
}
</style>

<script>
(function() {
  console.log('Cart drawer script loading...');
  
  function initCartDrawer() {
    const cartDrawer = document.querySelector('.cart-drawer');
    const cartOverlay = document.querySelector('.cart-drawer-overlay');
    const cartClose = document.querySelector('.cart-drawer-close');
    
    console.log('Cart drawer elements found:', {
      drawer: !!cartDrawer,
      overlay: !!cartOverlay,
      close: !!cartClose
    });
    
    if (!cartDrawer) {
      console.error('Cart drawer not found in DOM!');
      return;
    }
  
  // Apply Sub Total font styles - SEPARATE FUNCTION
  function applySubTotalStyles() {
    const subtotalLabel = document.querySelector('.cart-subtotal-label');
    const subtotalPrice = document.querySelector('.cart-subtotal-price');
    
    if (subtotalLabel) {
      subtotalLabel.style.cssText = `
        font-weight: 800 !important;
        color: #000000 !important;
        font-size: 18px !important;
      `;
    }
    
    if (subtotalPrice) {
      subtotalPrice.style.cssText = `
        font-weight: 800 !important;
        color: #000000 !important;
        font-size: 20px !important;
      `;
    }
  }
  
  // Apply Header Indentation - VERTICAL LAYOUT
  function applyHeaderIndentation() {
    const header = document.querySelector('.cart-drawer-header');
    const closeBtn = document.querySelector('.cart-drawer-close');
    const title = document.querySelector('.cart-drawer-title');
    
    if (header) {
      header.style.cssText = `
        padding: 15px 20px 25px 20px !important;
        border-bottom: none !important;
        position: relative !important;
        background: #ffffff !important;
        min-height: 80px !important;
      `;
      
      // Add indented border line
      if (!header.querySelector('.header-border-line')) {
        const borderLine = document.createElement('div');
        borderLine.className = 'header-border-line';
        borderLine.style.cssText = `
          position: absolute !important;
          bottom: 0 !important;
          left: 15px !important;
          right: 20px !important;
          height: 1px !important;
          background: #e0e0e0 !important;
        `;
        header.appendChild(borderLine);
      }
    }
    
    if (closeBtn) {
      closeBtn.style.cssText = `
        position: absolute !important;
        top: 15px !important;
        left: 15px !important;
        background: transparent !important;
        border: none !important;
        cursor: pointer !important;
        padding: 0px !important;
        color: #000000 !important;
        z-index: 10001 !important;
      `;
    }
    
    // DO NOT apply inline styles to title - it causes flicker
    // Title already has correct CSS styles defined in <style> section
  }
  
  // Open cart drawer - ENSURE VISIBILITY
  function openCart() {
    console.log('Opening cart drawer...');
    
    const cartDrawer = document.querySelector('.cart-drawer');
    const cartOverlay = document.querySelector('.cart-drawer-overlay');
    
    if (!cartDrawer) {
      console.error('Cart drawer not found!');
      return;
    }
    
    // Force show drawer immediately
    cartDrawer.classList.add('active');
    cartDrawer.style.right = '0px';
    cartDrawer.style.visibility = 'visible';
    cartDrawer.style.opacity = '1';
    cartDrawer.style.pointerEvents = 'auto';
    
    if (cartOverlay) {
      cartOverlay.classList.add('active');
      cartOverlay.style.opacity = '1';
      cartOverlay.style.visibility = 'visible';
      cartOverlay.style.pointerEvents = 'auto';
    }
    
    document.body.style.overflow = 'hidden';
    
    console.log('Cart drawer should be visible now');
    
    // Force apply indentation styles immediately - NO DELAY
    const header = cartDrawer.querySelector('.cart-drawer-header');
    const items = cartDrawer.querySelector('.cart-drawer-items');
    const closeBtn = cartDrawer.querySelector('.cart-drawer-close');
    const title = cartDrawer.querySelector('.cart-drawer-title');
    const subtotal = cartDrawer.querySelector('.cart-subtotal');
      
      if (header) {
        header.style.cssText = `
          padding: 15px 0 0 0 !important;
          border-bottom: none !important;
          position: relative !important;
          background: #ffffff !important;
          min-height: auto !important;
          display: flex !important;
          flex-direction: column !important;
        `;
        
        // Add indented border line
        if (!header.querySelector('.header-border-line')) {
          const borderLine = document.createElement('div');
          borderLine.className = 'header-border-line';
          borderLine.style.cssText = `
            position: absolute !important;
            bottom: 0 !important;
            left: 20px !important;
            right: 20px !important;
            height: 1px !important;
            background: #e0e0e0 !important;
          `;
          header.appendChild(borderLine);
        }
      }
      if (items) {
        items.style.padding = '10px 20px 10px 20px';
      }
      if (closeBtn) {
        closeBtn.style.cssText = `
          position: absolute !important;
          top: 15px !important;
          left: 20px !important;
          background: transparent !important;
          border: none !important;
          cursor: pointer !important;
          padding: 0px !important;
          color: #000000 !important;
          z-index: 10001 !important;
        `;
      }
      // DO NOT apply inline styles to title - it causes flicker
      // Title already has correct CSS styles defined above
      if (subtotal) {
        subtotal.style.cssText = `
          display: flex !important;
          justify-content: space-between !important;
          align-items: center !important;
          margin: 0 auto 25px auto !important;
          padding: 15px 20px !important;
          font-size: 16px !important;
          border-top: 2px solid #000000 !important;
          border-bottom: 2px solid #000000 !important;
          border-left: none !important;
          border-right: none !important;
          width: 85% !important;
          max-width: 320px !important;
          box-sizing: border-box !important;
          background: #ffffff !important;
        `;
      }
      
      // Force apply to all product titles
      const productTitles = cartDrawer.querySelectorAll('.cart-item-title');
      productTitles.forEach(titleEl => {
        titleEl.style.cssText = `
          font-size: 16px !important;
          font-weight: 600 !important;
          color: #000000 !important;
          margin: 0 0 10px 0 !important;
          padding: 0 !important;
          line-height: 1.3 !important;
          display: -webkit-box !important;
          -webkit-line-clamp: 4 !important;
          -webkit-box-orient: vertical !important;
          overflow: hidden !important;
          text-overflow: ellipsis !important;
          max-height: calc(1.3em * 4) !important;
          height: auto !important;
          cursor: pointer !important;
          white-space: normal !important;
          word-wrap: break-word !important;
          overflow-wrap: break-word !important;
        `;
      });
    
    // Then fetch and update data in background
    fetch('/cart.js')
      .then(response => response.json())
      .then(cartData => {
        console.log('Cart data for open drawer:', cartData);
        console.log('Items:', cartData.items.map(item => `${item.product_title}: qty=${item.quantity}`));
        
        // Update everything with fresh data
        updateCartDrawer(cartData);
        updateCartCount(cartData.item_count);
        
        console.log('Cart drawer synchronized with', cartData.item_count, 'total items');
        
        // Apply Sub Total font styles
        applySubTotalStyles();
        
        // DO NOT apply header indentation - it causes title to flicker
        // Header and title already have correct CSS styles
      })
      .catch(error => {
        console.error('Error fetching cart data:', error);
      });
  }
  
  // Close cart drawer
  function closeCart() {
    console.log('Closing cart drawer...');
    
    const cartDrawer = document.querySelector('.cart-drawer');
    const cartOverlay = document.querySelector('.cart-drawer-overlay');
    
    if (cartDrawer) {
      cartDrawer.classList.remove('active');
      cartDrawer.style.right = '-400px';
    }
    
    if (cartOverlay) {
      cartOverlay.classList.remove('active');
      cartOverlay.style.opacity = '0';
      cartOverlay.style.visibility = 'hidden';
    }
    
    document.body.style.overflow = '';
    console.log('Cart drawer closed');
  }
  
  // Handle cart icon clicks
  cartLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      console.log('Cart link clicked:', this);
      openCart();
      return false;
    });
  });
  
  // Additional event listener for any cart-related clicks - USE CAPTURE
  document.addEventListener('click', function(e) {
    // Check if clicking on cart icon/link
    if (e.target.closest('a[href="/cart"]') ||
        e.target.closest('a[href*="/cart"]') ||
        e.target.closest('.cart-link-luxe') || 
        e.target.closest('.header__icon--cart') ||
        e.target.closest('.cart-count') ||
        e.target.closest('[data-cart-drawer]') ||
        e.target.closest('[data-cart-icon]') ||
        e.target.closest('.cart-icon') ||
        e.target.closest('.cart-link') ||
        e.target.closest('.site-header__cart')) {
      
      e.preventDefault();
      e.stopPropagation();
      console.log('Cart clicked via document listener:', e.target);
      
      // Always refresh cart data before opening
      openCart();
      return false;
    }
  }, true); // USE CAPTURE PHASE
  
  // Close on overlay click
  if (cartOverlay) {
    cartOverlay.addEventListener('click', closeCart);
  }
  
  // Close on close button click
  if (cartClose) {
    cartClose.addEventListener('click', closeCart);
  }
  
  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && cartDrawer.classList.contains('active')) {
      closeCart();
    }
  });
  
  // Quantity controls - COMPACT VERSION
  document.addEventListener('click', function(e) {
    // Handle plus button
    if (e.target.classList.contains('qty-plus') || e.target.closest('.qty-plus')) {
      e.preventDefault();
      e.stopPropagation();
      
      const button = e.target.classList.contains('qty-plus') ? e.target : e.target.closest('.qty-plus');
      const line = button.dataset.line;
      const input = button.parentElement.querySelector('.qty-input');
      const currentQty = parseInt(input.value) || 0;
      const newQty = currentQty + 1;
      
      console.log('Plus clicked - Line:', line, 'Current:', currentQty, 'New:', newQty);
      
      // Update input immediately for instant feedback
      input.value = newQty;
      
      // Update quantity display immediately
      const qtyDisplay = button.parentElement.parentElement.querySelector('.cart-item-quantity');
      if (qtyDisplay) {
        qtyDisplay.textContent = `${newQty} ×`;
      }
      
      // Update cart in background
      updateCartFast(line, newQty);
      return false;
    }
    
    // Handle minus button
    if (e.target.classList.contains('qty-minus') || e.target.closest('.qty-minus')) {
      e.preventDefault();
      e.stopPropagation();
      
      const button = e.target.classList.contains('qty-minus') ? e.target : e.target.closest('.qty-minus');
      const line = button.dataset.line;
      const input = button.parentElement.querySelector('.qty-input');
      const currentQty = parseInt(input.value) || 0;
      const newQty = Math.max(0, currentQty - 1);
      
      console.log('Minus clicked - Line:', line, 'Current:', currentQty, 'New:', newQty);
      
      // Update input immediately for instant feedback
      if (newQty > 0) {
        input.value = newQty;
        
        // Update quantity display immediately
        const qtyDisplay = button.parentElement.parentElement.querySelector('.cart-item-quantity');
        if (qtyDisplay) {
          qtyDisplay.textContent = `${newQty} ×`;
        }
      }
      
      // Update cart in background
      updateCartFast(line, newQty);
      return false;
    }
    
    // Handle remove button
    if (e.target.closest('.cart-item-remove')) {
      e.preventDefault();
      e.stopPropagation();
      
      const button = e.target.closest('.cart-item-remove');
      const line = button.dataset.line;
      
      console.log('Remove clicked - Line:', line);
      
      // Update cart to remove item
      updateCartFast(line, 0);
      return false;
    }
  });
  
  // Handle manual input changes
  document.addEventListener('input', function(e) {
    if (e.target.classList.contains('qty-input')) {
      const input = e.target;
      const line = input.dataset.line;
      let newQty = parseInt(input.value) || 0;
      
      // Ensure minimum quantity
      if (newQty < 0) {
        newQty = 0;
        input.value = newQty;
      }
      
      console.log('Manual input - Line:', line, 'New quantity:', newQty);
      
      // Update quantity display immediately
      const qtyDisplay = input.parentElement.parentElement.querySelector('.cart-item-quantity');
      if (qtyDisplay && newQty > 0) {
        qtyDisplay.textContent = `${newQty}×`;
      }
      
      // Debounce the cart update to avoid too many API calls
      clearTimeout(input.updateTimeout);
      input.updateTimeout = setTimeout(() => {
        updateCartFast(line, newQty);
      }, 500); // Wait 500ms after user stops typing
    }
  });
  
  // Handle product title expand/collapse
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('cart-item-title') || e.target.closest('.cart-item-title')) {
      e.preventDefault();
      e.stopPropagation();
      
      const titleElement = e.target.classList.contains('cart-item-title') ? e.target : e.target.closest('.cart-item-title');
      
      // Toggle expanded class
      titleElement.classList.toggle('expanded');
      
      console.log('Product title clicked, expanded:', titleElement.classList.contains('expanded'));
      return false;
    }
  });
  
  // Update cart via AJAX - FAST VERSION (no button disable)
  function updateCartFast(line, quantity) {
    console.log('Fast updating cart - Line:', line, 'Quantity:', quantity);
    
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        line: line,
        quantity: quantity
      })
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      return response.json();
    })
    .then(data => {
      console.log('Cart updated successfully:', data);
      
      // Update cart count in header immediately
      updateCartCount(data.item_count);
      
      // Update subtotal immediately
      const subtotalPrice = document.querySelector('.cart-subtotal-price');
      if (subtotalPrice) {
        subtotalPrice.textContent = formatMoney(data.total_price);
      }
      
      // Update drawer title count
      const titleCount = document.querySelector('.cart-drawer-title .cart-count');
      if (titleCount) {
        titleCount.textContent = data.item_count;
      }
      
      // If quantity is 0, remove the item from display immediately
      if (quantity === 0) {
        const cartItem = document.querySelector(`[data-line="${line}"]`);
        if (cartItem) {
          cartItem.remove();
          
          // Re-render if cart is empty
          if (data.item_count === 0) {
            const cartItemsContainer = document.querySelector('.cart-drawer-items');
            if (cartItemsContainer) {
              cartItemsContainer.innerHTML = '<div class="cart-drawer-empty"><p>No products in the cart.</p></div>';
            }
          }
        }
      }
      
      console.log('Fast cart update completed');
    })
    .catch(error => {
      console.error('Error updating cart:', error);
      
      // Revert the input value on error
      const input = document.querySelector(`[data-line="${line}"] .qty-input`);
      if (input) {
        // Fetch current cart to get correct value
        fetch('/cart.js')
          .then(response => response.json())
          .then(cartData => {
            const item = cartData.items[line - 1];
            if (item) {
              input.value = item.quantity;
              const qtyDisplay = input.parentElement.parentElement.querySelector('.cart-item-quantity');
              if (qtyDisplay) {
                qtyDisplay.textContent = `${item.quantity}×`;
              }
            }
          });
      }
    });
  }
  
  // Update cart via AJAX - FULLY SYNCHRONIZED VERSION
  function updateCart(line, quantity) {
    console.log('Updating cart - Line:', line, 'Quantity:', quantity);
    
    // Disable all quantity buttons temporarily to prevent double clicks
    const allQtyButtons = document.querySelectorAll('.qty-btn, .cart-item-remove');
    allQtyButtons.forEach(btn => btn.disabled = true);
    
    // Show visual feedback immediately
    const targetInput = document.querySelector(`[data-line="${line}"] .qty-input`);
    if (targetInput && quantity > 0) {
      targetInput.style.opacity = '0.5';
    }
    
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        line: line,
        quantity: quantity
      })
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      return response.json();
    })
    .then(data => {
      console.log('Cart updated successfully:', data);
      
      // IMMEDIATELY fetch fresh cart data to ensure accuracy
      return fetch('/cart.js');
    })
    .then(response => response.json())
    .then(freshCartData => {
      console.log('Fresh cart data received:', freshCartData);
      
      // Update cart count in header immediately
      updateCartCount(freshCartData.item_count);
      
      // Update cart drawer content completely with fresh data
      updateCartDrawer(freshCartData);
      
      // Re-enable buttons
      setTimeout(() => {
        const newQtyButtons = document.querySelectorAll('.qty-btn, .cart-item-remove');
        newQtyButtons.forEach(btn => btn.disabled = false);
        
        // Remove visual feedback
        const allInputs = document.querySelectorAll('.qty-input');
        allInputs.forEach(input => input.style.opacity = '1');
      }, 150);
    })
    .catch(error => {
      console.error('Error updating cart:', error);
      
      // Re-enable buttons on error
      allQtyButtons.forEach(btn => btn.disabled = false);
      
      // Remove visual feedback
      if (targetInput) {
        targetInput.style.opacity = '1';
      }
      
      // Reload page as fallback
      location.reload();
    });
  }
  
  // Update cart count in header - IMPROVED VERSION
  function updateCartCount(count) {
    console.log('Updating cart count to:', count);
    
    // Update all possible cart count selectors
    const cartCountSelectors = [
      '.cart-count-luxe', 
      '.cart-count',
      '[data-cart-count]', 
      '.cart-item-count', 
      '.header-cart-count', 
      '.cart-counter', 
      '.cart-badge',
      '.cart-count-badge',
      '.cart-bubble',
      '.header__icon--cart .cart-count',
      '.site-header__cart-count',
      '.cart-link .cart-count'
    ];
    
    cartCountSelectors.forEach(selector => {
      const elements = document.querySelectorAll(selector);
      elements.forEach(element => {
        // Different formats for different elements
        if (element.classList.contains('cart-count-luxe')) {
          element.textContent = `(${count})`;
        } else {
          element.textContent = count;
        }
        element.setAttribute('data-count', count);
        
        // Show/hide badge based on count
        if (count > 0) {
          element.style.display = 'inline';
          element.style.visibility = 'visible';
          element.style.opacity = '1';
        } else if (element.classList.contains('cart-badge') || element.classList.contains('cart-bubble')) {
          element.style.display = 'none';
        }
      });
    });
    
    // Force update any text nodes that might contain cart count
    const allElements = document.querySelectorAll('*');
    allElements.forEach(el => {
      if (el.textContent && el.textContent.match(/^\(\d+\)$/)) {
        el.textContent = `(${count})`;
      }
    });
    
    console.log('Cart count updated successfully');
  }
  
  // Update cart drawer content dynamically - CLEAN VERSION
  function updateCartDrawer(cartData) {
    console.log('Updating cart drawer with:', cartData.item_count, 'items');
    
    // Check if drawer is already updated with this data to prevent unnecessary re-renders
    const currentCount = document.querySelector('.cart-drawer-title .cart-count');
    if (currentCount && currentCount.textContent == cartData.item_count) {
      console.log('Cart drawer already up to date, skipping re-render');
      return;
    }
    
    // Update cart count in drawer title - ONLY UPDATE NUMBER, NOT ENTIRE TITLE
    const cartCount = document.querySelector('.cart-drawer-title .cart-count');
    if (cartCount) {
      cartCount.textContent = cartData.item_count;
    }
    
    // DO NOT update drawer title completely to avoid flicker
    // The title is already rendered in HTML with correct structure
    
    // Update subtotal
    const subtotalPrice = document.querySelector('.cart-subtotal-price');
    if (subtotalPrice) {
      subtotalPrice.textContent = formatMoney(cartData.total_price);
    }
    
    // Render cart items - this will update all quantities
    renderCartItems(cartData);
    
    // Show/hide footer
    const cartFooter = document.querySelector('.cart-drawer-footer');
    if (cartFooter) {
      cartFooter.style.display = cartData.item_count > 0 ? 'block' : 'none';
    }
    
    // Apply Sub Total font styles immediately - NO DELAY
    applySubTotalStyles();
    
    console.log('Cart drawer updated successfully');
  }
  
  // Format money (basic implementation) - FIXED VERSION
  function formatMoney(cents) {
    if (typeof cents !== 'number') {
      cents = parseInt(cents) || 0;
    }
    
    // Simple money formatting without Shopify dependency
    const dollars = (cents / 100).toFixed(2);
    return '$' + dollars;
  }
  
  // Render cart items dynamically - FIXED LAYOUT
  function renderCartItems(cartData) {
    const cartItemsContainer = document.querySelector('.cart-drawer-items');
    if (!cartItemsContainer) return;
    
    console.log('Rendering cart items - Total count:', cartData.item_count);
    console.log('Items array length:', cartData.items.length);
    
    if (cartData.item_count === 0) {
      cartItemsContainer.innerHTML = '<div class="cart-drawer-empty"><p>No products in the cart.</p></div>';
      return;
    }
    
    let itemsHTML = '';
    cartData.items.forEach((item, index) => {
      const lineNumber = index + 1;
      
      itemsHTML += `
        <div class="cart-drawer-item" data-cart-item="${item.key}" data-line="${lineNumber}">
          <div class="cart-item-image">
            <a href="${item.url}">
              ${item.image ? 
                `<img src="${item.image}" alt="${item.title || item.product_title}" width="100" height="100" loading="lazy">` :
                '<div style="width:100px;height:100px;background:#f0f0f0;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#999;">No Image</div>'
              }
            </a>
          </div>
          
          <div class="cart-item-details">
            <h3 class="cart-item-title">
              <a href="${item.url}">${item.product_title || item.title}</a>
            </h3>
            
            <div class="cart-item-price-qty">
              <span class="cart-item-quantity">${item.quantity}×</span>
              <span class="cart-item-price">${formatMoney(item.final_price || item.price)}</span>
            </div>
            
            <div class="cart-item-controls">
              <div class="quantity-selector">
                <button class="qty-btn qty-minus" data-line="${lineNumber}" aria-label="Decrease quantity">−</button>
                <input type="number" class="qty-input" value="${item.quantity}" min="0" data-line="${lineNumber}">
                <button class="qty-btn qty-plus" data-line="${lineNumber}" aria-label="Increase quantity">+</button>
              </div>
              
              <button class="cart-item-remove" data-line="${lineNumber}" aria-label="Remove item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      `;
    });
    
    cartItemsContainer.innerHTML = itemsHTML;
    console.log('Cart items rendered:', cartData.items.length, 'items');
    
    // Apply styles immediately - NO setTimeout to prevent flicker
    const items = cartItemsContainer.querySelectorAll('.cart-drawer-item');
    items.forEach(item => {
        item.style.cssText = `
          display: flex !important;
          flex-direction: row !important;
          align-items: flex-start !important;
          gap: 15px !important;
          padding: 15px 0 !important;
          margin: 0 0 0 15px !important;
          border-bottom: 1px solid #e0e0e0 !important;
          min-height: 120px !important;
          background: #ffffff !important;
          width: calc(100% - 15px) !important;
        `;
        
        const image = item.querySelector('.cart-item-image');
        if (image) {
          image.style.cssText = `
            flex: 0 0 100px !important;
            width: 100px !important;
            height: 100px !important;
            background: #f9f9f9 !important;
            border-radius: 6px !important;
            overflow: hidden !important;
            flex-shrink: 0 !important;
          `;
        }
        
        const details = item.querySelector('.cart-item-details');
        if (details) {
          details.style.cssText = `
            flex: 1 !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: flex-start !important;
            padding: 0 0 0 15px !important;
            min-height: 100px !important;
          `;
        }
        
        const title = item.querySelector('.cart-item-title');
        if (title) {
          title.style.cssText = `
            font-size: 16px !important;
            font-weight: 600 !important;
            color: #000000 !important;
            margin: 0 0 10px 0 !important;
            padding: 0 !important;
            line-height: 1.3 !important;
            display: -webkit-box !important;
            -webkit-line-clamp: 4 !important;
            -webkit-box-orient: vertical !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-height: calc(1.3em * 4) !important;
            cursor: pointer !important;
            white-space: normal !important;
            word-wrap: break-word !important;
            overflow-wrap: break-word !important;
            position: relative !important;
          `;
          
          // Add click handler for expand/collapse
          title.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            if (title.classList.contains('expanded')) {
              title.style.webkitLineClamp = '4';
              title.style.maxHeight = 'calc(1.3em * 4)';
              title.style.overflow = 'hidden';
              title.classList.remove('expanded');
            } else {
              title.style.webkitLineClamp = 'unset';
              title.style.maxHeight = 'none';
              title.style.overflow = 'visible';
              title.classList.add('expanded');
            }
          });
          
          // Check if text is actually truncated and show ellipsis
          setTimeout(() => {
            const isOverflowing = title.scrollHeight > title.clientHeight;
            if (isOverflowing && !title.classList.contains('expanded')) {
              title.style.position = 'relative';
              if (!title.querySelector('.ellipsis-indicator')) {
                const ellipsis = document.createElement('span');
                ellipsis.className = 'ellipsis-indicator';
                ellipsis.textContent = '...';
                ellipsis.style.cssText = `
                  position: absolute !important;
                  bottom: 0 !important;
                  right: 0 !important;
                  background: white !important;
                  padding-left: 5px !important;
                  font-weight: 600 !important;
                  color: #000000 !important;
                  cursor: pointer !important;
                `;
                title.appendChild(ellipsis);
              }
            }
          }, 100);
        }
        
        const priceQty = item.querySelector('.cart-item-price-qty');
        if (priceQty) {
          priceQty.style.cssText = `
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            font-size: 14px !important;
            color: #000000 !important;
            margin: 0 0 15px 0 !important;
          `;
        }
        
        const controls = item.querySelector('.cart-item-controls');
        if (controls) {
          controls.style.cssText = `
            display: flex !important;
            align-items: center !important;
            justify-content: flex-start !important;
            gap: 20px !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
          `;
        }
      });
      
      // Force apply Sub Total borders
      const subtotal = cartItemsContainer.parentElement.querySelector('.cart-subtotal');
      if (subtotal) {
        subtotal.style.cssText = `
          display: flex !important;
          justify-content: space-between !important;
          align-items: center !important;
          margin: 0 auto 25px auto !important;
          padding: 15px 20px !important;
          font-size: 16px !important;
          border-top: 2px solid #000000 !important;
          border-bottom: 2px solid #000000 !important;
          border-left: none !important;
          border-right: none !important;
          width: 85% !important;
          max-width: 320px !important;
          box-sizing: border-box !important;
          background: #ffffff !important;
        `;
      }
      
      // Apply Sub Total font styles immediately
      applySubTotalStyles();
    });
  }
  
  // Listen for custom cart events from other scripts
  document.addEventListener('cart:updated', function(e) {
    console.log('Cart updated event received:', e.detail);
    console.log('Cart drawer found:', !!document.querySelector('.cart-drawer'));
    
    // Fetch latest cart data and open drawer
    fetch('/cart.js')
      .then(response => response.json())
      .then(cartData => {
        console.log('Cart data after custom event:', cartData);
        
        // Update everything
        updateCartCount(cartData.item_count);
        updateCartDrawer(cartData);
        
        // Open cart drawer
        openCart();
      })
      .catch(error => {
        console.error('Error handling cart event:', error);
      });
  });
  
  // Listen for add to cart - use click instead of submit to override Shopify
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('custom-add-to-cart') || e.target.closest('.custom-add-to-cart')) {
      e.preventDefault();
      e.stopPropagation();
      
      const button = e.target.classList.contains('custom-add-to-cart') ? e.target : e.target.closest('.custom-add-to-cart');
      const form = button.closest('form');
      const formData = new FormData(form);
      
      // Prevent default form submission
      if (form) {
        form.addEventListener('submit', function(submitEvent) {
          submitEvent.preventDefault();
        });
      }
      
      // Show loading state
      button.classList.add('loading');
      button.disabled = true;
      
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        // Show success state
        button.classList.remove('loading');
        button.classList.add('success');
        
        // Fetch updated cart IMMEDIATELY
        return fetch('/cart.js');
      })
      .then(response => response.json())
      .then(cartData => {
        // Update cart count immediately - BEFORE opening drawer
        updateCartCount(cartData.item_count);
        
        // DO NOT call updateCartDrawer here - openCart will handle it
        // This prevents double rendering and flicker
        
        // Open cart IMMEDIATELY with correct count - NO DELAY
        openCart();
        
        // Reset button after opening cart
        setTimeout(() => {
          button.classList.remove('success');
          button.disabled = false;
        }, 2000);
      })
      .catch(error => {
        console.error('Error:', error);
        
        // Reset button on error
        button.classList.remove('loading');
        button.disabled = false;
        
        // Fallback
        location.reload();
      });
    }
  });
  
  // Also prevent form submission
  document.addEventListener('submit', function(e) {
    if (e.target.classList.contains('product-form')) {
      e.preventDefault();
      return false;
    }
  });
  
  // Add event listener for cart icon clicks to refresh cart
  document.addEventListener('click', function(e) {
    // Check if clicking on cart icon/link
    if (e.target.closest('.cart-link-luxe') || 
        e.target.closest('[href*="cart"]') || 
        e.target.closest('.header__icon--cart') ||
        e.target.closest('.cart-count') ||
        e.target.closest('[data-cart-drawer]')) {
      
      e.preventDefault();
      
      // Always refresh cart data before opening
      openCart();
    }
  });
  
  // Refresh cart drawer when page becomes visible (in case cart was updated in another tab)
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden && cartDrawer.classList.contains('active')) {
      // Refresh cart if drawer is open and page becomes visible
      fetch('/cart.js')
        .then(response => response.json())
        .then(cartData => {
          updateCartDrawer(cartData);
          updateCartCount(cartData.item_count);
        })
        .catch(error => {
          console.error('Error refreshing cart:', error);
        });
    }
  });
  
  // Initialize immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartDrawer);
  } else {
    initCartDrawer();
  }
})();
</script>