{% comment %}
  Product card snippet - Simplified for grid display
  Handles price display with compare_at_price logic
{% endcomment %}

<div class="product-card">
  <div class="product-card__image">
    <a href="{{ product.url | default: '#' }}">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 400 }}" 
             alt="{{ product.featured_media.alt | default: product.title | escape }}" 
             width="400" 
             height="400" 
             loading="lazy" 
             class="product-card__img">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {% endif %}
    </a>
    
    {% if product.compare_at_price > product.price %}
      <div class="product-card__badge">
        <span class="badge-sale">Sale</span>
      </div>
    {% endif %}
  </div>
  
  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url | default: '#' }}">{{ product.title | default: 'Product title' }}</a>
    </h3>
    
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="price price--sale">{{ product.price | money }}</span>
        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span class="price">{{ product.price | default: '$0.00' | money }}</span>
      {% endif %}
    </div>
    
    <!-- Add to Cart Button -->
    {% if product %}
      <div class="product-card__actions">
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product-card__form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="product-card__add-to-cart" 
                  {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </button>
        </form>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 400px;
    transition: all 0.7s ease;
  }
  
  .product-card__image {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    margin-bottom: 8px;
    width: 100%;
    height: 250px;
    flex-shrink: 0;
  }
  
  .product-card__image a {
    display: block;
    width: 100%;
    height: 100%;
  }
  
  .product-card__img,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }
  
  .product-card:hover .product-card__img {
    transform: scale(1.05);
    transition: transform 0.7s ease;
  }
  
  .product-card__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
  }
  
  .badge-sale {
    background: #000000;
    color: white;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .product-card__info {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    justify-content: space-between;
  }
  
  .product-card__title {
    font-size: 1.3125rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
    text-align: center;
    transition: all 0.7s ease;
  }
  
  .product-card__title a {
    color: #000;
    text-decoration: none;
    transition: all 0.7s ease;
  }
  
  .product-card:hover .product-card__title {
    font-weight: 700;
    transition: all 0.7s ease;
  }
  
  .product-card:hover .product-card__title a {
    text-decoration: underline;
    transition: all 0.7s ease;
  }
  
  .product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.3125rem;
    padding-left: 15px;
  }
  
  .price {
    font-weight: 600;
  }
  
  .price--sale {
    color: #000000;
  }
  
  .price--compare {
    color: #999;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 1.21875rem;
  }
  
  /* Add to Cart Button */
  .product-card__actions {
    margin-top: 12px;
  }
  
  .product-card__form {
    margin: 0;
  }
  
  .product-card__add-to-cart {
    width: 100%;
    padding: 10px 16px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .product-card__add-to-cart:hover:not(:disabled) {
    background: #333;
    transform: translateY(-1px);
  }
  
  .product-card__add-to-cart:disabled {
    background: #ccc;
    color: #666;
    cursor: not-allowed;
  }
  
  @media (max-width: 749px) {
    .product-card {
      height: 380px;
    }
    
    .product-card__image {
      height: 220px;
    }
    
    .product-card__title {
      font-size: 1.21875rem;
    }
    
    .product-card__price {
      font-size: 1.21875rem;
      padding-left: 10px;
    }
    
    .price--compare {
      font-size: 1.125rem;
    }
    
    .product-card__add-to-cart {
      padding: 8px 12px;
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  // Add to Cart functionality for product cards
  document.addEventListener('DOMContentLoaded', function() {
    const addToCartForms = document.querySelectorAll('.product-card__form');
    
    addToCartForms.forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const button = this.querySelector('.product-card__add-to-cart');
        const originalText = button.textContent;
        
        // Show loading state
        button.textContent = 'Adding...';
        button.disabled = true;
        
        // Submit form data
        fetch(window.routes.cart_add_url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: new FormData(this)
        })
        .then(response => response.json())
        .then(data => {
          // Success feedback
          button.textContent = 'Added!';
          button.style.background = '#007bff';
          
          // Update cart count if element exists
          const cartCount = document.querySelector('.cart-count-luxe');
          if (cartCount) {
            fetch('/cart.js')
              .then(response => response.json())
              .then(cart => {
                cartCount.textContent = `(${cart.item_count})`;
              });
          }
          
          // Reset button after 2 seconds
          setTimeout(() => {
            button.textContent = originalText;
            button.style.background = '';
            button.disabled = false;
          }, 2000);
        })
        .catch(error => {
          console.error('Error:', error);
          button.textContent = 'Error';
          button.style.background = '#007bff';
          
          // Reset button after 2 seconds
          setTimeout(() => {
            button.textContent = originalText;
            button.style.background = '';
            button.disabled = false;
          }, 2000);
        });
      });
    });
  });
</script>