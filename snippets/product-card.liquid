{% comment %}
  Product card snippet - Simplified for grid display
  Handles price display with compare_at_price logic
{% endcomment %}

<div class="product-card">
  <div class="product-card__image">
    <a href="{{ product.url | default: '#' }}">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 400 }}" 
             alt="{{ product.featured_media.alt | default: product.title | escape }}" 
             width="400" 
             height="400" 
             loading="lazy" 
             class="product-card__img">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {% endif %}
    </a>
    
    {% if product.compare_at_price > product.price %}
      <div class="product-card__badge">
        <span class="badge-sale">Sale</span>
      </div>
    {% endif %}
  </div>
  
  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ product.url | default: '#' }}">{{ product.title | default: 'Product title' }}</a>
    </h3>
    
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="price price--sale">{{ product.price | money }}</span>
        <span class="price price--compare">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span class="price">{{ product.price | default: '$0.00' | money }}</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: auto;
  }
  
  .product-card__image {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    margin-bottom: 8px;
    width: 100%;
  }
  
  .product-card__image a {
    display: block;
    width: 100%;
  }
  
  .product-card__img,
  .product-card__placeholder {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    display: block;
  }
  
  .product-card:hover .product-card__img {
    transform: scale(1.05);
    transition: transform 0.3s ease;
  }
  
  .product-card__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
  }
  
  .badge-sale {
    background: #dc3545;
    color: white;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .product-card__info {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .product-card__title {
    font-size: 0.875rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
  }
  
  .product-card__title a {
    color: #000;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .product-card__title a:hover {
    opacity: 0.7;
  }
  
  .product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
  }
  
  .price {
    font-weight: 600;
  }
  
  .price--sale {
    color: #dc3545;
  }
  
  .price--compare {
    color: #999;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 0.8125rem;
  }
  
  @media (max-width: 749px) {
    .product-card__title {
      font-size: 0.8125rem;
    }
    
    .product-card__price {
      font-size: 0.8125rem;
    }
  }
</style>