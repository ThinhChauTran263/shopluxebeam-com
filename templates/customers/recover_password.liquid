{% comment %}
  Customer Recover Password Template
{% endcomment %}

<div class="customer-recover-page">
  <div class="container">
    <div class="recover-wrapper">
      <div class="recover-form-container">
        {% if form.posted_successfully? %}
          <div class="success-message">
            <h1>Password Reset Sent</h1>
            <p>We've sent you an email with a link to reset your password.</p>
            <a href="{{ routes.account_login_url }}" class="btn-back">Back to Login</a>
          </div>
        {% else %}
          <h1 class="recover-title">Forgot Password</h1>
          <p class="recover-description">Enter your email address and we'll send you a link to reset your password.</p>
          
          {% form 'recover_customer_password', class: 'recover-form' %}
            {% if form.errors %}
              <div class="form-errors">
                <ul>
                  {% for error in form.errors %}
                    <li>{{ error }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="form-group">
              <label for="recover_email">Email</label>
              <input 
                type="email" 
                name="email" 
                id="recover_email" 
                value="{{ form.email }}"
                required
                autocomplete="email"
              >
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-recover">Send Reset Link</button>
            </div>
          {% endform %}

          <div class="login-link">
            <p>Remember your password? <a href="{{ routes.account_login_url }}">Sign in</a></p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
.customer-recover-page {
  padding: 60px 0;
  min-height: 60vh;
  display: flex;
  align-items: center;
}

.recover-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.recover-form-container {
  background: #ffffff;
  padding: 40px;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 400px;
}

.recover-title {
  text-align: center;
  margin-bottom: 15px;
  font-size: 28px;
  font-weight: 700;
  color: #000000;
}

.recover-description {
  text-align: center;
  margin-bottom: 30px;
  color: #666;
  font-size: 16px;
  line-height: 1.5;
}

.success-message {
  text-align: center;
}

.success-message h1 {
  font-size: 28px;
  font-weight: 700;
  color: #28a745;
  margin-bottom: 15px;
}

.success-message p {
  color: #666;
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 30px;
}

.form-errors {
  background: #fee;
  border: 1px solid #fcc;
  border-radius: 4px;
  padding: 15px;
  margin-bottom: 20px;
}

.form-errors ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.form-errors li {
  color: #c33;
  font-size: 14px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 600;
  color: #333;
}

.form-group input {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 16px;
  transition: border-color 0.3s;
}

.form-group input:focus {
  outline: none;
  border-color: #000000;
}

.form-actions {
  text-align: center;
  margin-bottom: 20px;
}

.btn-recover,
.btn-back {
  width: 100%;
  padding: 15px;
  background: #000000;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.3s;
  text-decoration: none;
  display: inline-block;
  text-align: center;
}

.btn-recover:hover,
.btn-back:hover {
  background: #333333;
}

.login-link {
  text-align: center;
  padding-top: 20px;
  border-top: 1px solid #eee;
}

.login-link p {
  margin: 0;
  color: #666;
}

.login-link a {
  color: #000;
  text-decoration: none;
  font-weight: 600;
}

.login-link a:hover {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .customer-recover-page {
    padding: 40px 0;
  }
  
  .recover-form-container {
    padding: 30px 20px;
    margin: 0 20px;
  }
  
  .recover-title,
  .success-message h1 {
    font-size: 24px;
  }
}
</style>