{% comment %}
  Customer Reset Password Template
{% endcomment %}

<div class="customer-reset-page">
  <div class="container">
    <div class="reset-wrapper">
      <div class="reset-form-container">
        <h1 class="reset-title">Reset Password</h1>
        
        {% form 'reset_customer_password', class: 'reset-form' %}
          {% if form.errors %}
            <div class="form-errors">
              <ul>
                {% for error in form.errors %}
                  <li>{{ error }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="form-group">
            <label for="customer_password">New Password</label>
            <input 
              type="password" 
              name="customer[password]" 
              id="customer_password"
              required
              autocomplete="new-password"
            >
          </div>

          <div class="form-group">
            <label for="customer_password_confirmation">Confirm Password</label>
            <input 
              type="password" 
              name="customer[password_confirmation]" 
              id="customer_password_confirmation"
              required
              autocomplete="new-password"
            >
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-reset">Reset Password</button>
          </div>
        {% endform %}

        <div class="login-link">
          <p><a href="{{ routes.account_login_url }}">Back to Login</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.customer-reset-page {
  padding: 60px 0;
  min-height: 60vh;
  display: flex;
  align-items: center;
}

.reset-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.reset-form-container {
  background: #ffffff;
  padding: 40px;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 400px;
}

.reset-title {
  text-align: center;
  margin-bottom: 30px;
  font-size: 28px;
  font-weight: 700;
  color: #000000;
}

.form-errors {
  background: #fee;
  border: 1px solid #fcc;
  border-radius: 4px;
  padding: 15px;
  margin-bottom: 20px;
}

.form-errors ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.form-errors li {
  color: #c33;
  font-size: 14px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  margin-bottom: 8px;
  font-weight: 600;
  color: #333;
}

.form-group input {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 16px;
  transition: border-color 0.3s;
}

.form-group input:focus {
  outline: none;
  border-color: #000000;
}

.form-actions {
  text-align: center;
  margin-bottom: 20px;
}

.btn-reset {
  width: 100%;
  padding: 15px;
  background: #000000;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.3s;
}

.btn-reset:hover {
  background: #333333;
}

.login-link {
  text-align: center;
  padding-top: 20px;
  border-top: 1px solid #eee;
}

.login-link p {
  margin: 0;
  color: #666;
}

.login-link a {
  color: #000;
  text-decoration: none;
  font-weight: 600;
}

.login-link a:hover {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .customer-reset-page {
    padding: 40px 0;
  }
  
  .reset-form-container {
    padding: 30px 20px;
    margin: 0 20px;
  }
  
  .reset-title {
    font-size: 24px;
  }
}
</style>