{% comment %}
  Collection template - converted from existing collection page structure
{% endcomment %}

<div class="collection-page section-ptb">
  <div class="container">
    <!-- Collection Header -->
    <div class="collection-header">
      <div class="section-capture">
        <div class="section-title">
          <h1>{{ collection.title }}</h1>
          {% if collection.description != blank %}
            <div class="collection-description">{{ collection.description }}</div>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Collection Filters and Sorting -->
    <div class="collection-toolbar">
      <div class="row align-items-center">
        <div class="col-md-6">
          <div class="collection-results">
            <p>{{ 'collections.general.items_with_count' | t: count: collection.products_count | default: 'Showing all products' }}</p>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="collection-sorting">
            <label for="sort-by">{{ 'collections.sorting.title' | t | default: 'Sort by:' }}</label>
            <select name="sort_by" id="sort-by" class="collection-sort-select">
              <option value="manual">{{ 'collections.sorting.featured' | t | default: 'Featured' }}</option>
              <option value="best-selling" {% if collection.sort_by == collection.default_sort_by %}selected{% endif %}>{{ 'collections.sorting.best_selling' | t | default: 'Best selling' }}</option>
              <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collections.sorting.az' | t | default: 'Alphabetically, A-Z' }}</option>
              <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>{{ 'collections.sorting.za' | t | default: 'Alphabetically, Z-A' }}</option>
              <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collections.sorting.price_ascending' | t | default: 'Price, low to high' }}</option>
              <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'collections.sorting.price_descending' | t | default: 'Price, high to low' }}</option>
              <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'collections.sorting.date_descending' | t | default: 'Date, new to old' }}</option>
              <option value="created-ascending" {% if collection.sort_by == 'created-ascending' %}selected{% endif %}>{{ 'collections.sorting.date_ascending' | t | default: 'Date, old to new' }}</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Collection Products -->
    <div class="collection-products">
      {% if collection.products.size > 0 %}
        <div class="row">
          {% for product in collection.products %}
            <div class="col-lg-3 col-md-6 col-sm-6 col-6">
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="pagination-wrapper">
            {% render 'pagination', paginate: paginate %}
          </div>
        {% endif %}
      {% else %}
        <div class="collection-empty">
          <div class="text-center">
            <h3>{{ 'collections.general.no_matches' | t | default: 'No products found' }}</h3>
            <p>{{ 'collections.general.no_matches_message' | t | default: 'Use fewer filters or clear all' }}</p>
            <a href="{{ collection.url }}" class="btn btn-style">
              {{ 'collections.general.clear_all' | t | default: 'Clear all' }}
            </a>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .collection-page {
    min-height: 60vh;
  }
  
  .collection-header .section-title h1 {
    font-size: 48px;
    margin-bottom: 20px;
    color: var(--font-color-header);
    text-align: center;
  }
  
  .collection-description {
    text-align: center;
    color: var(--font-color-paragraph);
    margin-bottom: 30px;
  }
  
  .collection-toolbar {
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--theme-border-color);
  }
  
  .collection-results p {
    margin: 0;
    color: var(--font-color-paragraph);
  }
  
  .collection-sorting {
    text-align: right;
  }
  
  .collection-sorting label {
    margin-right: 10px;
    font-weight: 600;
  }
  
  .collection-sort-select {
    padding: 8px 15px;
    border: var(--sti-border);
    border-radius: var(--sti-border-radius);
    background-color: var(--background-color-body);
  }
  
  .collection-products {
    margin-bottom: 60px;
  }
  
  .collection-empty {
    text-align: center;
    padding: 60px 0;
  }
  
  .collection-empty h3 {
    margin-bottom: 20px;
    color: var(--font-color-header);
  }
  
  .collection-empty p {
    margin-bottom: 30px;
    color: var(--font-color-paragraph);
  }
  
  .pagination-wrapper {
    margin-top: 60px;
  }
  
  @media (max-width: 767px) {
    .collection-header .section-title h1 {
      font-size: 36px;
    }
    
    .collection-toolbar .row {
      flex-direction: column;
    }
    
    .collection-results {
      margin-bottom: 20px;
      text-align: center;
    }
    
    .collection-sorting {
      text-align: center;
    }
  }
</style>

<script>
  // Collection sorting functionality
  document.addEventListener('DOMContentLoaded', function() {
    const sortSelect = document.getElementById('sort-by');
    
    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        const url = new URL(window.location);
        url.searchParams.set('sort_by', this.value);
        window.location.href = url.toString();
      });
    }
  });
</script>