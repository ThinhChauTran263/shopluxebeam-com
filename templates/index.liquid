{% comment %}
  Homepage template - LuxeBeam Theme
{% endcomment %}

<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="hero-content">
          <h1>Transform Your Space with LuxeBeam</h1>
          <p>Discover our curated collection of aesthetic lighting solutions for modern homes and spaces.</p>
          <a href="{{ collections.all.url }}" class="btn-style">Shop Now</a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="hero-image">
          <img src="https://via.placeholder.com/600x400/ff8200/ffffff?text=LuxeBeam+Lighting" alt="LuxeBeam Lighting" class="img-fluid">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="featured-products section-ptb">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="section-title text-center">
          <h2>Featured Products</h2>
          <p>Discover our most popular lighting solutions</p>
        </div>
      </div>
    </div>
    <div class="row">
      {% for product in collections.frontpage.products limit: 4 %}
        <div class="col-lg-3 col-md-6 mb-4">
          <div class="product-card">
            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}">
            {% else %}
              <img src="https://via.placeholder.com/300x250/cccccc/666666?text=Product+Image" alt="{{ product.title | escape }}">
            {% endif %}
            <div class="product-card-content">
              <h3 class="product-card-title">{{ product.title }}</h3>
              <div class="product-card-price">{{ product.price | money }}</div>
              <a href="{{ product.url }}" class="btn-style2">View Product</a>
            </div>
          </div>
        </div>
      {% else %}
        {% for i in (1..4) %}
          <div class="col-lg-3 col-md-6 mb-4">
            <div class="product-card">
              <img src="https://via.placeholder.com/300x250/ff8200/ffffff?text=Sample+Product+{{ i }}" alt="Sample Product {{ i }}">
              <div class="product-card-content">
                <h3 class="product-card-title">Sample Product {{ i }}</h3>
                <div class="product-card-price">$49.99</div>
                <a href="#" class="btn-style2">View Product</a>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- About Section -->
<section class="about-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="about-image">
          <img src="https://via.placeholder.com/500x400/0b101f/ffffff?text=About+LuxeBeam" alt="About LuxeBeam" class="img-fluid">
        </div>
      </div>
      <div class="col-lg-6">
        <div class="about-content">
          <h2>Why Choose LuxeBeam?</h2>
          <p>We specialize in aesthetic lighting solutions that transform any space into a modern, stylish environment. Our curated collection features:</p>
          <ul>
            <li>Galaxy & RGB lighting systems</li>
            <li>Smart home integration</li>
            <li>Energy-efficient LED technology</li>
            <li>Modern design aesthetics</li>
          </ul>
          <a href="{{ pages.about.url | default: '#' }}" class="btn-style">Learn More</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="newsletter-section section-ptb">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 text-center">
        <h2>Stay Updated</h2>
        <p>Subscribe to get special offers, free giveaways, and updates on new products.</p>
        <form action="{{ routes.cart_url }}" method="post" class="newsletter-form">
          <div class="input-group">
            <input type="email" name="contact[email]" placeholder="Enter your email" class="form-control" required>
            <button type="submit" class="btn-style">Subscribe</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
/* Hero Section */
.hero-section {
  padding: 100px 0;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.hero-content h1 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  color: #000000;
}

.hero-content p {
  font-size: 1.2rem;
  margin-bottom: 2rem;
  color: #6c757d;
}

/* Featured Products */
.featured-products {
  background: #ffffff;
}

.section-title h2 {
  font-size: 2.5rem;
  font-weight: 600;
  margin-bottom: 1rem;
  color: #000000;
}

.section-title p {
  font-size: 1.1rem;
  color: #6c757d;
  margin-bottom: 3rem;
}

/* About Section */
.about-section {
  padding: 100px 0;
  background: #f8f9fa;
}

.about-content h2 {
  font-size: 2.2rem;
  margin-bottom: 1.5rem;
  color: #000000;
}

.about-content ul {
  list-style: none;
  padding: 0;
  margin: 2rem 0;
}

.about-content li {
  padding: 0.5rem 0;
  position: relative;
  padding-left: 2rem;
}

.about-content li:before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #ff8200;
  font-weight: bold;
}

/* Newsletter */
.newsletter-section {
  background: #0b101f;
  color: #ffffff;
}

.newsletter-section h2 {
  color: #ffffff;
  margin-bottom: 1rem;
}

.newsletter-section p {
  color: #cccccc;
  margin-bottom: 2rem;
}

.newsletter-form {
  max-width: 400px;
  margin: 0 auto;
}

.input-group {
  display: flex;
  gap: 0;
}

.input-group .form-control {
  border-radius: 25px 0 0 25px;
  border-right: none;
  background: #ffffff;
  color: #000000;
}

.input-group .btn-style {
  border-radius: 0 25px 25px 0;
  border-left: none;
}

/* Responsive */
@media (max-width: 768px) {
  .hero-content h1 {
    font-size: 2rem;
  }
  
  .section-title h2 {
    font-size: 2rem;
  }
  
  .input-group {
    flex-direction: column;
    gap: 1rem;
  }
  
  .input-group .form-control,
  .input-group .btn-style {
    border-radius: 25px;
    border: 1px solid #ddd;
  }
}
</style>