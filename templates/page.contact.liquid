{% comment %}
  Contact page template - converted from contact.html
{% endcomment %}

<div class="contact-page section-ptb">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <div class="contact-content">
          <div class="section-capture">
            <div class="section-title">
              <h1>{{ page.title | default: 'Contact Us' }}</h1>
              {% if page.content != blank %}
                <div class="page-content">{{ page.content }}</div>
              {% else %}
                <p class="desc">Get in touch with us for any questions about our lighting products.</p>
              {% endif %}
            </div>
          </div>
          
          {% form 'contact', class: 'contact-form' %}
            {% if form.posted_successfully? %}
              <div class="contact-success">
                <h3>{{ 'contact.form.post_success' | t | default: 'Thanks for contacting us!' }}</h3>
                <p>{{ 'contact.form.post_success_message' | t | default: 'We will get back to you as soon as possible.' }}</p>
              </div>
            {% endif %}
            
            {% if form.errors %}
              <div class="contact-errors">
                <h4>{{ 'contact.form.error_heading' | t | default: 'Please correct the following errors:' }}</h4>
                <ul>
                  {% for field in form.errors %}
                    <li>
                      {% if field == 'form' %}
                        {{ form.errors.messages[field] }}
                      {% else %}
                        {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="contact-name">{{ 'contact.form.name' | t | default: 'Name' }} <span class="required">*</span></label>
                  <input type="text" 
                         name="contact[name]" 
                         id="contact-name" 
                         value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                         placeholder="{{ 'contact.form.name' | t | default: 'Name' }}"
                         required>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="form-group">
                  <label for="contact-email">{{ 'contact.form.email' | t | default: 'Email' }} <span class="required">*</span></label>
                  <input type="email" 
                         name="contact[email]" 
                         id="contact-email" 
                         value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                         placeholder="{{ 'contact.form.email' | t | default: 'Email' }}"
                         required>
                </div>
              </div>
            </div>
            
            <div class="form-group">
              <label for="contact-phone">{{ 'contact.form.phone' | t | default: 'Phone Number' }}</label>
              <input type="tel" 
                     name="contact[phone]" 
                     id="contact-phone" 
                     value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                     placeholder="{{ 'contact.form.phone' | t | default: 'Phone Number' }}">
            </div>
            
            <div class="form-group">
              <label for="contact-subject">{{ 'contact.form.subject' | t | default: 'Subject' }}</label>
              <input type="text" 
                     name="contact[subject]" 
                     id="contact-subject" 
                     value="{% if form.subject %}{{ form.subject }}{% endif %}"
                     placeholder="{{ 'contact.form.subject' | t | default: 'Subject' }}">
            </div>
            
            <div class="form-group">
              <label for="contact-message">{{ 'contact.form.message' | t | default: 'Message' }} <span class="required">*</span></label>
              <textarea name="contact[body]" 
                        id="contact-message" 
                        rows="6" 
                        placeholder="{{ 'contact.form.message' | t | default: 'Write your message here...' }}"
                        required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>
            
            <div class="form-group">
              <button type="submit" class="btn btn-style">
                {{ 'contact.form.send' | t | default: 'Send Message' }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
    
    {% comment %} Contact Information Section {% endcomment %}
    <div class="row contact-info-section">
      <div class="col-lg-4 col-md-6">
        <div class="contact-info-item">
          <div class="contact-info-icon">
            <i class="feather-map-pin"></i>
          </div>
          <div class="contact-info-content">
            <h4>{{ 'contact.info.address_title' | t | default: 'Our Address' }}</h4>
            <p>
              {% if shop.address %}
                {{ shop.address.address1 }}<br>
                {% if shop.address.address2 != blank %}{{ shop.address.address2 }}<br>{% endif %}
                {{ shop.address.city }}, {{ shop.address.province }} {{ shop.address.zip }}<br>
                {{ shop.address.country }}
              {% else %}
                123 Main Street<br>
                City, State 12345<br>
                United States
              {% endif %}
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4 col-md-6">
        <div class="contact-info-item">
          <div class="contact-info-icon">
            <i class="feather-phone"></i>
          </div>
          <div class="contact-info-content">
            <h4>{{ 'contact.info.phone_title' | t | default: 'Phone Number' }}</h4>
            <p>
              {% if shop.phone %}
                <a href="tel:{{ shop.phone }}">{{ shop.phone }}</a>
              {% else %}
                <a href="tel:+1234567890">+1 (234) 567-890</a>
              {% endif %}
            </p>
          </div>
        </div>
      </div>
      
      <div class="col-lg-4 col-md-6">
        <div class="contact-info-item">
          <div class="contact-info-icon">
            <i class="feather-mail"></i>
          </div>
          <div class="contact-info-content">
            <h4>{{ 'contact.info.email_title' | t | default: 'Email Address' }}</h4>
            <p>
              {% if shop.email %}
                <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
              {% else %}
                <a href="mailto:info@shopluxebeam.com">info@shopluxebeam.com</a>
              {% endif %}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-page {
    min-height: 60vh;
  }
  
  .contact-content .section-title h1 {
    font-size: 48px;
    margin-bottom: 20px;
    color: var(--font-color-header);
    text-align: center;
  }
  
  .contact-content .section-title .page-content,
  .contact-content .section-title .desc {
    text-align: center;
    margin-bottom: 50px;
    color: var(--font-color-paragraph);
  }
  
  .contact-form {
    background-color: #f8f9fa;
    padding: 40px;
    border-radius: var(--sti-border-radius);
    margin-bottom: 60px;
  }
  
  .contact-success {
    background-color: #d4edda;
    color: #155724;
    padding: 20px;
    border-radius: var(--sti-border-radius);
    margin-bottom: 30px;
    border: 1px solid #c3e6cb;
  }
  
  .contact-success h3 {
    margin-bottom: 10px;
    color: #155724;
  }
  
  .contact-errors {
    background-color: #f8d7da;
    color: #721c24;
    padding: 20px;
    border-radius: var(--sti-border-radius);
    margin-bottom: 30px;
    border: 1px solid #f5c6cb;
  }
  
  .contact-errors h4 {
    margin-bottom: 15px;
    color: #721c24;
  }
  
  .contact-errors ul {
    margin: 0;
    padding-left: 20px;
  }
  
  .form-group {
    margin-bottom: 25px;
  }
  
  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--font-color-header);
  }
  
  .required {
    color: #dc3545;
  }
  
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 15px;
    border: var(--sti-border);
    border-radius: var(--sti-border-radius);
    font-size: 16px;
    transition: border-color 0.3s ease;
  }
  
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--font-color-primary);
  }
  
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
  
  .contact-info-section {
    margin-top: 60px;
  }
  
  .contact-info-item {
    display: flex;
    align-items: flex-start;
    padding: 30px;
    background-color: #f8f9fa;
    border-radius: var(--sti-border-radius);
    margin-bottom: 30px;
    height: 100%;
  }
  
  .contact-info-icon {
    width: 60px;
    height: 60px;
    background-color: var(--font-color-primary);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-right: 20px;
    flex-shrink: 0;
  }
  
  .contact-info-content h4 {
    font-size: 20px;
    margin-bottom: 10px;
    color: var(--font-color-header);
  }
  
  .contact-info-content p {
    margin: 0;
    color: var(--font-color-paragraph);
    line-height: 1.6;
  }
  
  .contact-info-content a {
    color: var(--font-color-primary);
    text-decoration: none;
  }
  
  .contact-info-content a:hover {
    text-decoration: underline;
  }
  
  @media (max-width: 767px) {
    .contact-content .section-title h1 {
      font-size: 36px;
    }
    
    .contact-form {
      padding: 30px 20px;
    }
    
    .contact-info-item {
      padding: 20px;
    }
    
    .contact-info-icon {
      width: 50px;
      height: 50px;
      font-size: 20px;
      margin-right: 15px;
    }
    
    .contact-info-content h4 {
      font-size: 18px;
    }
  }
</style>